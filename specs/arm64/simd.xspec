// The floor: SIMD, floating point, and whatever else is left.
//
// Negative-priority rules that match wide swathes of the encoding space, so that
// an instruction this spec does not model is a known intrinsic rather than an
// undecodable word. Anything added elsewhere wins over these without them being
// edited, which is why they can be written this broadly.
// ---------------------------------------------------------------------------
// SIMD and floating point
// ---------------------------------------------------------------------------
//
// Start with operations whose values the current DSL can express exactly. The
// register file calls the 128-bit view `q`; it deliberately has no arrangement
// printer, so assembly below uses the internal q/d names rather than claiming a
// particular `vN.<arrangement>` spelling.
//
// The DSL has no lane map or loop. Fixed-width lane arithmetic is nevertheless
// expressible without an intrinsic: the masks below prevent a carry or borrow
// from escaping its lane.
fn read_vec(n: int(0..31), q: int(0..1)) -> bits(64 << q) {
  if q == 1 {
    return vec[n];
  } else {
    return vec[n].d;
  }
}

fn write_vec(n: int(0..31), q: int(0..1), v: bits(64 << q)) {
  if q == 1 {
    vec[n] = v;
  } else {
    vec[n].d = v;
  }
}

// Compile-time xspec integers are 64-bit, so construct Q results from two
// D-sized computations rather than silently truncating a 128-bit mask.
//
// Modular addition in lanes of `lane_bits`. The partial sum omits each lane's
// top bit, so it cannot carry into the next lane.
fn add_lanes64(lane_bits: int, a: bits(64), b: bits(64)) -> bits(64) {
  let lo = imm(replicate_int(ones_int(lane_bits - 1), lane_bits, 64), 64);
  let hi = imm(replicate_int(1 << (lane_bits - 1), lane_bits, 64), 64);
  let sum = (a & lo) + (b & lo);
  return (sum & lo) | ((a ^ b ^ sum) & hi);
}

fn add_lanes(q: int(0..1), lane_bits: int, a: bits(64 << q), b: bits(64 << q))
    -> bits(64 << q) {
  if q == 1 {
    return concat(add_lanes64(lane_bits, extract(a, 64, 64), extract(b, 64, 64)),
                  add_lanes64(lane_bits, extract(a, 0, 64), extract(b, 0, 64)));
  } else {
    return add_lanes64(lane_bits, a, b);
  }
}

// Bias each low lane with its top bit, making packed subtraction non-borrowing
// at the word level. `~diff` then holds the per-lane borrow bit.
fn sub_lanes64(lane_bits: int, a: bits(64), b: bits(64)) -> bits(64) {
  let lo = imm(replicate_int(ones_int(lane_bits - 1), lane_bits, 64), 64);
  let hi = imm(replicate_int(1 << (lane_bits - 1), lane_bits, 64), 64);
  let diff = ((a & lo) | hi) - (b & lo);
  return (diff & lo) | ((a ^ b ^ ~diff) & hi);
}

fn sub_lanes(q: int(0..1), lane_bits: int, a: bits(64 << q), b: bits(64 << q))
    -> bits(64 << q) {
  if q == 1 {
    return concat(sub_lanes64(lane_bits, extract(a, 64, 64), extract(b, 64, 64)),
                  sub_lanes64(lane_bits, extract(a, 0, 64), extract(b, 0, 64)));
  } else {
    return sub_lanes64(lane_bits, a, b);
  }
}

// Multiplication cannot be faked the way addition is: a product needs the
// full width of its lane, so there is no spare bit to keep a carry out of the
// neighbour. Each lane is written out. There is no 64-bit lane form of MUL to
// cover, which is why the widths stop at 32.
fn mul_lanes8_64(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(
      concat(concat(extract(a, 56, 8) * extract(b, 56, 8),
                    extract(a, 48, 8) * extract(b, 48, 8)),
             concat(extract(a, 40, 8) * extract(b, 40, 8),
                    extract(a, 32, 8) * extract(b, 32, 8))),
      concat(concat(extract(a, 24, 8) * extract(b, 24, 8),
                    extract(a, 16, 8) * extract(b, 16, 8)),
             concat(extract(a, 8, 8) * extract(b, 8, 8),
                    extract(a, 0, 8) * extract(b, 0, 8))));
}

fn mul_lanes16_64(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(
      concat(extract(a, 48, 16) * extract(b, 48, 16),
             extract(a, 32, 16) * extract(b, 32, 16)),
      concat(extract(a, 16, 16) * extract(b, 16, 16),
             extract(a, 0, 16) * extract(b, 0, 16)));
}

fn mul_lanes32_64(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(extract(a, 32, 32) * extract(b, 32, 32),
                extract(a, 0, 32) * extract(b, 0, 32));
}

fn mul_lanes64(lane_bits: int, a: bits(64), b: bits(64)) -> bits(64) {
  if lane_bits == 8 {
    return mul_lanes8_64(a, b);
  } else {
    if lane_bits == 16 {
      return mul_lanes16_64(a, b);
    } else {
      return mul_lanes32_64(a, b);
    }
  }
}

fn mul_lanes(q: int(0..1), lane_bits: int, a: bits(64 << q), b: bits(64 << q))
    -> bits(64 << q) {
  if q == 1 {
    return concat(mul_lanes64(lane_bits, extract(a, 64, 64), extract(b, 64, 64)),
                  mul_lanes64(lane_bits, extract(a, 0, 64), extract(b, 0, 64)));
  } else {
    return mul_lanes64(lane_bits, a, b);
  }
}

// XTN keeps the low `lane_bits` of each double-width source element, packing
// the 128-bit input down to 64 bits.
fn xtn8_64(v: bits(128)) -> bits(64) {
  return concat(
      concat(concat(extract(v, 112, 8), extract(v, 96, 8)),
             concat(extract(v, 80, 8), extract(v, 64, 8))),
      concat(concat(extract(v, 48, 8), extract(v, 32, 8)),
             concat(extract(v, 16, 8), extract(v, 0, 8))));
}

fn xtn16_64(v: bits(128)) -> bits(64) {
  return concat(concat(extract(v, 96, 16), extract(v, 64, 16)),
                concat(extract(v, 32, 16), extract(v, 0, 16)));
}

fn xtn32_64(v: bits(128)) -> bits(64) {
  return concat(extract(v, 64, 32), extract(v, 0, 32));
}

fn xtn_narrow(lane_bits: int, v: bits(128)) -> bits(64) {
  if lane_bits == 8 {
    return xtn8_64(v);
  } else {
    if lane_bits == 16 {
      return xtn16_64(v);
    } else {
      return xtn32_64(v);
    }
  }
}

fn shl_lanes64(lane_bits: int, v: bits(64), amount: int) -> bits(64) {
  let keep = imm(replicate_int(ones_int(lane_bits - amount), lane_bits, 64), 64);
  return (v & keep) << imm(amount, 64);
}

fn shl_lanes(q: int(0..1), lane_bits: int, v: bits(64 << q), amount: int)
    -> bits(64 << q) {
  if q == 1 {
    return concat(shl_lanes64(lane_bits, extract(v, 64, 64), amount),
                  shl_lanes64(lane_bits, extract(v, 0, 64), amount));
  } else {
    return shl_lanes64(lane_bits, v, amount);
  }
}

// The post-shift mask removes bits that shifted in from the next physical lane.
fn ushr_lanes64(lane_bits: int, v: bits(64), amount: int) -> bits(64) {
  let keep = imm(replicate_int(ones_int(lane_bits - amount), lane_bits, 64), 64);
  return (v >> imm(amount, 64)) & keep;
}

fn ushr_lanes(q: int(0..1), lane_bits: int, v: bits(64 << q), amount: int)
    -> bits(64 << q) {
  if q == 1 {
    return concat(ushr_lanes64(lane_bits, extract(v, 64, 64), amount),
                  ushr_lanes64(lane_bits, extract(v, 0, 64), amount));
  } else {
    return ushr_lanes64(lane_bits, v, amount);
  }
}

fn ushll_8_to_16(v: bits(64), amount: int) -> bits(128) {
  return concat(
      concat(concat(zext(extract(v, 56, 8), 16) << imm(amount, 16),
                    zext(extract(v, 48, 8), 16) << imm(amount, 16)),
             concat(zext(extract(v, 40, 8), 16) << imm(amount, 16),
                    zext(extract(v, 32, 8), 16) << imm(amount, 16))),
      concat(concat(zext(extract(v, 24, 8), 16) << imm(amount, 16),
                    zext(extract(v, 16, 8), 16) << imm(amount, 16)),
             concat(zext(extract(v, 8, 8), 16) << imm(amount, 16),
                    zext(extract(v, 0, 8), 16) << imm(amount, 16))));
}

fn ushll_16_to_32(v: bits(64), amount: int) -> bits(128) {
  return concat(
      concat(zext(extract(v, 48, 16), 32) << imm(amount, 32),
             zext(extract(v, 32, 16), 32) << imm(amount, 32)),
      concat(zext(extract(v, 16, 16), 32) << imm(amount, 32),
             zext(extract(v, 0, 16), 32) << imm(amount, 32)));
}

fn ushll_32_to_64(v: bits(64), amount: int) -> bits(128) {
  return concat(zext(extract(v, 32, 32), 64) << imm(amount, 64),
                zext(extract(v, 0, 32), 64) << imm(amount, 64));
}

fn ushll_lanes(lane_bits: int, v: bits(64), amount: int) -> bits(128) {
  if lane_bits == 8 {
    return ushll_8_to_16(v, amount);
  } else if lane_bits == 16 {
    return ushll_16_to_32(v, amount);
  } else {
    return ushll_32_to_64(v, amount);
  }
}

fn sshll_8_to_16(v: bits(64), amount: int) -> bits(128) {
  return concat(
      concat(concat(sext(extract(v, 56, 8), 16) << imm(amount, 16),
                    sext(extract(v, 48, 8), 16) << imm(amount, 16)),
             concat(sext(extract(v, 40, 8), 16) << imm(amount, 16),
                    sext(extract(v, 32, 8), 16) << imm(amount, 16))),
      concat(concat(sext(extract(v, 24, 8), 16) << imm(amount, 16),
                    sext(extract(v, 16, 8), 16) << imm(amount, 16)),
             concat(sext(extract(v, 8, 8), 16) << imm(amount, 16),
                    sext(extract(v, 0, 8), 16) << imm(amount, 16))));
}

fn sshll_16_to_32(v: bits(64), amount: int) -> bits(128) {
  return concat(
      concat(sext(extract(v, 48, 16), 32) << imm(amount, 32),
             sext(extract(v, 32, 16), 32) << imm(amount, 32)),
      concat(sext(extract(v, 16, 16), 32) << imm(amount, 32),
             sext(extract(v, 0, 16), 32) << imm(amount, 32)));
}

fn sshll_32_to_64(v: bits(64), amount: int) -> bits(128) {
  return concat(sext(extract(v, 32, 32), 64) << imm(amount, 64),
                sext(extract(v, 0, 32), 64) << imm(amount, 64));
}

fn sshll_lanes(lane_bits: int, v: bits(64), amount: int) -> bits(128) {
  if lane_bits == 8 {
    return sshll_8_to_16(v, amount);
  } else if lane_bits == 16 {
    return sshll_16_to_32(v, amount);
  } else {
    return sshll_32_to_64(v, amount);
  }
}

fn umull_8_to_16(a: bits(64), b: bits(64)) -> bits(128) {
  return concat(
      concat(concat(zext(extract(a, 56, 8), 16) * zext(extract(b, 56, 8), 16),
                    zext(extract(a, 48, 8), 16) * zext(extract(b, 48, 8), 16)),
             concat(zext(extract(a, 40, 8), 16) * zext(extract(b, 40, 8), 16),
                    zext(extract(a, 32, 8), 16) * zext(extract(b, 32, 8), 16))),
      concat(concat(zext(extract(a, 24, 8), 16) * zext(extract(b, 24, 8), 16),
                    zext(extract(a, 16, 8), 16) * zext(extract(b, 16, 8), 16)),
             concat(zext(extract(a, 8, 8), 16) * zext(extract(b, 8, 8), 16),
                    zext(extract(a, 0, 8), 16) * zext(extract(b, 0, 8), 16))));
}

fn umull_16_to_32(a: bits(64), b: bits(64)) -> bits(128) {
  return concat(
      concat(zext(extract(a, 48, 16), 32) * zext(extract(b, 48, 16), 32),
             zext(extract(a, 32, 16), 32) * zext(extract(b, 32, 16), 32)),
      concat(zext(extract(a, 16, 16), 32) * zext(extract(b, 16, 16), 32),
             zext(extract(a, 0, 16), 32) * zext(extract(b, 0, 16), 32)));
}

fn umull_32_to_64(a: bits(64), b: bits(64)) -> bits(128) {
  return concat(zext(extract(a, 32, 32), 64) * zext(extract(b, 32, 32), 64),
                zext(extract(a, 0, 32), 64) * zext(extract(b, 0, 32), 64));
}

fn umull_lanes(lane_bits: int, a: bits(64), b: bits(64)) -> bits(128) {
  if lane_bits == 8 {
    return umull_8_to_16(a, b);
  } else if lane_bits == 16 {
    return umull_16_to_32(a, b);
  } else {
    return umull_32_to_64(a, b);
  }
}

fn even_bytes64(v: bits(64)) -> bits(32) {
  return concat(concat(extract(v, 48, 8), extract(v, 32, 8)),
                concat(extract(v, 16, 8), extract(v, 0, 8)));
}

fn even_bytes128(v: bits(128)) -> bits(64) {
  return concat(even_bytes64(extract(v, 64, 64)),
                even_bytes64(extract(v, 0, 64)));
}

fn even_halfwords128(v: bits(128)) -> bits(64) {
  return concat(
      concat(extract(v, 96, 16), extract(v, 64, 16)),
      concat(extract(v, 32, 16), extract(v, 0, 16)));
}

fn odd_bytes128(v: bits(128)) -> bits(64) {
  return concat(
      concat(concat(extract(v, 120, 8), extract(v, 104, 8)),
             concat(extract(v, 88, 8), extract(v, 72, 8))),
      concat(concat(extract(v, 56, 8), extract(v, 40, 8)),
             concat(extract(v, 24, 8), extract(v, 8, 8))));
}

fn odd_halfwords128(v: bits(128)) -> bits(64) {
  return concat(
      concat(extract(v, 112, 16), extract(v, 80, 16)),
      concat(extract(v, 48, 16), extract(v, 16, 16)));
}

fn even_words128(v: bits(128)) -> bits(64) {
  return concat(extract(v, 64, 32), extract(v, 0, 32));
}

fn odd_words128(v: bits(128)) -> bits(64) {
  return concat(extract(v, 96, 32), extract(v, 32, 32));
}

fn narrow_8h_to_8b(v: bits(128)) -> bits(64) {
  return concat(
      concat(concat(extract(v, 112, 8), extract(v, 96, 8)),
             concat(extract(v, 80, 8), extract(v, 64, 8))),
      concat(concat(extract(v, 48, 8), extract(v, 32, 8)),
             concat(extract(v, 16, 8), extract(v, 0, 8))));
}

fn narrow_4s_to_4h(v: bits(128)) -> bits(64) {
  return concat(
      concat(extract(v, 96, 16), extract(v, 64, 16)),
      concat(extract(v, 32, 16), extract(v, 0, 16)));
}

fn uaddw_4s_4h(acc: bits(128), src: bits(64)) -> bits(128) {
  return concat(
      concat(extract(acc, 96, 32) + zext(extract(src, 48, 16), 32),
             extract(acc, 64, 32) + zext(extract(src, 32, 16), 32)),
      concat(extract(acc, 32, 32) + zext(extract(src, 16, 16), 32),
             extract(acc, 0, 32) + zext(extract(src, 0, 16), 32)));
}

fn usubw_8h_8b(acc: bits(128), src: bits(64)) -> bits(128) {
  return concat(
      concat(concat(extract(acc, 112, 16) - zext(extract(src, 56, 8), 16),
                    extract(acc, 96, 16) - zext(extract(src, 48, 8), 16)),
             concat(extract(acc, 80, 16) - zext(extract(src, 40, 8), 16),
                    extract(acc, 64, 16) - zext(extract(src, 32, 8), 16))),
      concat(concat(extract(acc, 48, 16) - zext(extract(src, 24, 8), 16),
                    extract(acc, 32, 16) - zext(extract(src, 16, 8), 16)),
             concat(extract(acc, 16, 16) - zext(extract(src, 8, 8), 16),
                    extract(acc, 0, 16) - zext(extract(src, 0, 8), 16))));
}

fn usubw_4s_4h(acc: bits(128), src: bits(64)) -> bits(128) {
  return concat(
      concat(extract(acc, 96, 32) - zext(extract(src, 48, 16), 32),
             extract(acc, 64, 32) - zext(extract(src, 32, 16), 32)),
      concat(extract(acc, 32, 32) - zext(extract(src, 16, 16), 32),
             extract(acc, 0, 32) - zext(extract(src, 0, 16), 32)));
}

fn usubw_2d_2s(acc: bits(128), src: bits(64)) -> bits(128) {
  return concat(extract(acc, 64, 64) - zext(extract(src, 32, 32), 64),
                extract(acc, 0, 64) - zext(extract(src, 0, 32), 64));
}

fn usubw_lanes(lane_bits: int, acc: bits(128), src: bits(64)) -> bits(128) {
  if lane_bits == 8 {
    return usubw_8h_8b(acc, src);
  } else if lane_bits == 16 {
    return usubw_4s_4h(acc, src);
  } else {
    return usubw_2d_2s(acc, src);
  }
}

fn cmhi32(a: bits(32), b: bits(32)) -> bits(32) {
  return select(b <u a, imm(0xffffffff, 32), imm(0, 32));
}

fn cmhi8(a: bits(8), b: bits(8)) -> bits(8) {
  return select(b <u a, imm(0xff, 8), imm(0, 8));
}

fn cmhi16(a: bits(16), b: bits(16)) -> bits(16) {
  return select(b <u a, imm(0xffff, 16), imm(0, 16));
}

fn cmhi64(a: bits(64), b: bits(64)) -> bits(64) {
  return select(b <u a, imm(0xffffffffffffffff, 64), imm(0, 64));
}

fn cmhi_8b(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(
      concat(concat(cmhi8(extract(a, 56, 8), extract(b, 56, 8)),
                    cmhi8(extract(a, 48, 8), extract(b, 48, 8))),
             concat(cmhi8(extract(a, 40, 8), extract(b, 40, 8)),
                    cmhi8(extract(a, 32, 8), extract(b, 32, 8)))),
      concat(concat(cmhi8(extract(a, 24, 8), extract(b, 24, 8)),
                    cmhi8(extract(a, 16, 8), extract(b, 16, 8))),
             concat(cmhi8(extract(a, 8, 8), extract(b, 8, 8)),
                    cmhi8(extract(a, 0, 8), extract(b, 0, 8)))));
}

fn cmhi_4h(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(
      concat(cmhi16(extract(a, 48, 16), extract(b, 48, 16)),
             cmhi16(extract(a, 32, 16), extract(b, 32, 16))),
      concat(cmhi16(extract(a, 16, 16), extract(b, 16, 16)),
             cmhi16(extract(a, 0, 16), extract(b, 0, 16))));
}

fn cmhi_2s(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(cmhi32(extract(a, 32, 32), extract(b, 32, 32)),
                cmhi32(extract(a, 0, 32), extract(b, 0, 32)));
}

fn cmhi_half(lane_bits: int, a: bits(64), b: bits(64)) -> bits(64) {
  if lane_bits == 8 {
    return cmhi_8b(a, b);
  } else if lane_bits == 16 {
    return cmhi_4h(a, b);
  } else if lane_bits == 32 {
    return cmhi_2s(a, b);
  } else {
    return cmhi64(a, b);
  }
}

fn addv8_64(v: bits(64)) -> bits(8) {
  return extract(v, 0, 8) + extract(v, 8, 8)
       + extract(v, 16, 8) + extract(v, 24, 8)
       + extract(v, 32, 8) + extract(v, 40, 8)
       + extract(v, 48, 8) + extract(v, 56, 8);
}

fn addv16_64(v: bits(64)) -> bits(16) {
  return extract(v, 0, 16) + extract(v, 16, 16)
       + extract(v, 32, 16) + extract(v, 48, 16);
}

fn addv32_64(v: bits(64)) -> bits(32) {
  return extract(v, 0, 32) + extract(v, 32, 32);
}

fn cmlt8(v: bits(8)) -> bits(8) {
  return select(v < imm(0, 8), imm(0xff, 8), imm(0, 8));
}

fn cmlt_8b(v: bits(64)) -> bits(64) {
  return concat(
      concat(concat(cmlt8(extract(v, 56, 8)), cmlt8(extract(v, 48, 8))),
             concat(cmlt8(extract(v, 40, 8)), cmlt8(extract(v, 32, 8)))),
      concat(concat(cmlt8(extract(v, 24, 8)), cmlt8(extract(v, 16, 8))),
             concat(cmlt8(extract(v, 8, 8)), cmlt8(extract(v, 0, 8)))));
}

fn cmeq0_32(v: bits(32)) -> bits(32) {
  return select(v == imm(0, 32), imm(0xffffffff, 32), imm(0, 32));
}

fn cmeq0_4s(v: bits(128)) -> bits(128) {
  return concat(
      concat(cmeq0_32(extract(v, 96, 32)), cmeq0_32(extract(v, 64, 32))),
      concat(cmeq0_32(extract(v, 32, 32)), cmeq0_32(extract(v, 0, 32))));
}

/// USHL takes its shift amount from the low signed byte of the control lane:
/// positive shifts left, negative shifts right, and either direction clears
/// the lane once the magnitude reaches the lane width. The magnitude is
/// clamped before it reaches a shift operator so that an out-of-range amount
/// never has to be well defined there.
fn ushl32(v: bits(32), control: bits(32)) -> bits(32) {
  let amount = sext(extract(control, 0, 8), 32);
  let negative = amount < imm(0, 32);
  let magnitude = select(negative, imm(0, 32) - amount, amount);
  let inrange = magnitude <u imm(32, 32);
  let safe = select(inrange, magnitude, imm(0, 32));
  return select(inrange, select(negative, v >> safe, v << safe), imm(0, 32));
}

fn ushl_4s(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(
      concat(ushl32(extract(a, 96, 32), extract(b, 96, 32)),
             ushl32(extract(a, 64, 32), extract(b, 64, 32))),
      concat(ushl32(extract(a, 32, 32), extract(b, 32, 32)),
             ushl32(extract(a, 0, 32), extract(b, 0, 32))));
}

fn dup8_64(v: bits(8)) -> bits(64) {
  let pair = concat(v, v);
  let quad = concat(pair, pair);
  return concat(quad, quad);
}

fn dup16_64(v: bits(16)) -> bits(64) {
  let pair = concat(v, v);
  return concat(pair, pair);
}

fn dup32_64(v: bits(32)) -> bits(64) {
  return concat(v, v);
}

/// Writes a 64-bit pattern to a vector, doubled when the instruction is the
/// full-width form. The narrow form zeroes the upper half, which is why this
/// goes through `write_vec` rather than assigning the `d` view directly.
fn write_dup64(n: int(0..31), q: int(0..1), half: bits(64)) {
  if q == 1 {
    write_vec(n, q, concat(half, half));
  } else {
    write_vec(n, q, half);
  }
}

// Floating vector arithmetic is expanded lane-by-lane into the existing scalar
// float IL. The DSL has no vector value type yet, so this preserves the exact
// per-lane operation instead of hiding it behind an opaque intrinsic.
fn neon_fadd_2s(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(bitcast_int(fadd(bitcast_float(extract(a, 32, 32), 32),
                                bitcast_float(extract(b, 32, 32), 32)), 32),
                bitcast_int(fadd(bitcast_float(extract(a, 0, 32), 32),
                                bitcast_float(extract(b, 0, 32), 32)), 32));
}

fn neon_fadd_4s(a: bits(128), b: bits(128)) -> bits(128) {
  let low = neon_fadd_2s(trunc(a, 64), trunc(b, 64));
  let high = neon_fadd_2s(extract(a, 64, 64), extract(b, 64, 64));
  return concat(high, low);
}

fn neon_fadd_2d(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(bitcast_int(fadd(bitcast_float(extract(a, 64, 64), 64),
                                bitcast_float(extract(b, 64, 64), 64)), 64),
                bitcast_int(fadd(bitcast_float(extract(a, 0, 64), 64),
                                bitcast_float(extract(b, 0, 64), 64)), 64));
}

fn neon_fsub_2s(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(bitcast_int(fsub(bitcast_float(extract(a, 32, 32), 32),
                                bitcast_float(extract(b, 32, 32), 32)), 32),
                bitcast_int(fsub(bitcast_float(extract(a, 0, 32), 32),
                                bitcast_float(extract(b, 0, 32), 32)), 32));
}

fn neon_fsub_4s(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(neon_fsub_2s(extract(a, 64, 64), extract(b, 64, 64)),
                neon_fsub_2s(trunc(a, 64), trunc(b, 64)));
}

fn neon_fsub_2d(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(bitcast_int(fsub(bitcast_float(extract(a, 64, 64), 64),
                                bitcast_float(extract(b, 64, 64), 64)), 64),
                bitcast_int(fsub(bitcast_float(extract(a, 0, 64), 64),
                                bitcast_float(extract(b, 0, 64), 64)), 64));
}

fn neon_fmul_2s(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(bitcast_int(fmul(bitcast_float(extract(a, 32, 32), 32),
                                bitcast_float(extract(b, 32, 32), 32)), 32),
                bitcast_int(fmul(bitcast_float(extract(a, 0, 32), 32),
                                bitcast_float(extract(b, 0, 32), 32)), 32));
}

fn neon_fmul_4s(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(neon_fmul_2s(extract(a, 64, 64), extract(b, 64, 64)),
                neon_fmul_2s(trunc(a, 64), trunc(b, 64)));
}

fn neon_fmul_2d(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(bitcast_int(fmul(bitcast_float(extract(a, 64, 64), 64),
                                bitcast_float(extract(b, 64, 64), 64)), 64),
                bitcast_int(fmul(bitcast_float(extract(a, 0, 64), 64),
                                bitcast_float(extract(b, 0, 64), 64)), 64));
}

fn neon_fdiv_2s(a: bits(64), b: bits(64)) -> bits(64) {
  return concat(bitcast_int(fdiv(bitcast_float(extract(a, 32, 32), 32),
                                bitcast_float(extract(b, 32, 32), 32)), 32),
                bitcast_int(fdiv(bitcast_float(extract(a, 0, 32), 32),
                                bitcast_float(extract(b, 0, 32), 32)), 32));
}

fn neon_fdiv_4s(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(neon_fdiv_2s(extract(a, 64, 64), extract(b, 64, 64)),
                neon_fdiv_2s(trunc(a, 64), trunc(b, 64)));
}

fn neon_fdiv_2d(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(bitcast_int(fdiv(bitcast_float(extract(a, 64, 64), 64),
                                bitcast_float(extract(b, 64, 64), 64)), 64),
                bitcast_int(fdiv(bitcast_float(extract(a, 0, 64), 64),
                                bitcast_float(extract(b, 0, 64), 64)), 64));
}

fn neon_fsqrt_2s(a: bits(64)) -> bits(64) {
  return concat(bitcast_int(fsqrt(bitcast_float(extract(a, 32, 32), 32)), 32),
                bitcast_int(fsqrt(bitcast_float(extract(a, 0, 32), 32)), 32));
}

fn neon_fsqrt_4s(a: bits(128)) -> bits(128) {
  return concat(neon_fsqrt_2s(extract(a, 64, 64)), neon_fsqrt_2s(trunc(a, 64)));
}

fn neon_fsqrt_2d(a: bits(128)) -> bits(128) {
  return concat(bitcast_int(fsqrt(bitcast_float(extract(a, 64, 64), 64)), 64),
                bitcast_int(fsqrt(bitcast_float(extract(a, 0, 64), 64)), 64));
}

// Comparison results are integer masks: every bit of a true lane is one.
fn neon_fcmeq_2s(a: bits(64), b: bits(64)) -> bits(64) {
  let a0 = bitcast_float(extract(a, 0, 32), 32);
  let b0 = bitcast_float(extract(b, 0, 32), 32);
  let a1 = bitcast_float(extract(a, 32, 32), 32);
  let b1 = bitcast_float(extract(b, 32, 32), 32);
  return concat(select(fcmp_eq(a1, b1), imm(0xffffffff, 32), imm(0, 32)),
                select(fcmp_eq(a0, b0), imm(0xffffffff, 32), imm(0, 32)));
}

fn neon_fcmeq_4s(a: bits(128), b: bits(128)) -> bits(128) {
  return concat(neon_fcmeq_2s(extract(a, 64, 64), extract(b, 64, 64)),
                neon_fcmeq_2s(trunc(a, 64), trunc(b, 64)));
}

fn neon_fcmeq_2d(a: bits(128), b: bits(128)) -> bits(128) {
  let a0 = bitcast_float(extract(a, 0, 64), 64);
  let b0 = bitcast_float(extract(b, 0, 64), 64);
  let a1 = bitcast_float(extract(a, 64, 64), 64);
  let b1 = bitcast_float(extract(b, 64, 64), 64);
  return concat(select(fcmp_eq(a1, b1), imm(0xffffffffffffffff, 64), imm(0, 64)),
                select(fcmp_eq(a0, b0), imm(0xffffffffffffffff, 64), imm(0, 64)));
}

// Three-same vector FP operations.  The S forms use D for two lanes and Q for
// four; the D form is always Q and therefore has no Q field.
insn neon_fadd_2s_4s {
  encoding "0" Q:1 "001110" "00" "1" Rm:5 "110101" Rn:5 Rd:5
  asm "fadd {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fadd_2s(read_vec(Rn, 0), read_vec(Rm, 0)));
    } else {
      write_vec(Rd, 1, neon_fadd_4s(read_vec(Rn, 1), read_vec(Rm, 1)));
    }
  }
}

insn neon_fadd_2d {
  encoding "0" "1" "001110" "01" "1" Rm:5 "110101" Rn:5 Rd:5
  asm "fadd v{Rd:dec}.2d, v{Rn:dec}.2d, v{Rm:dec}.2d"
  semantics {
    write_vec(Rd, 1, neon_fadd_2d(vec[Rn], vec[Rm]));
  }
}

insn neon_fsub_2s_4s {
  encoding "0" Q:1 "001110" "10" "1" Rm:5 "110101" Rn:5 Rd:5
  asm "fsub {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fsub_2s(read_vec(Rn, 0), read_vec(Rm, 0)));
    } else {
      write_vec(Rd, 1, neon_fsub_4s(read_vec(Rn, 1), read_vec(Rm, 1)));
    }
  }
}

insn neon_fsub_2d {
  encoding "0" "1" "001110" "11" "1" Rm:5 "110101" Rn:5 Rd:5
  asm "fsub v{Rd:dec}.2d, v{Rn:dec}.2d, v{Rm:dec}.2d"
  semantics {
    write_vec(Rd, 1, neon_fsub_2d(vec[Rn], vec[Rm]));
  }
}

insn neon_fmul_2s_4s {
  encoding "0" Q:1 "101110" "00" "1" Rm:5 "110111" Rn:5 Rd:5
  asm "fmul {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fmul_2s(read_vec(Rn, 0), read_vec(Rm, 0)));
    } else {
      write_vec(Rd, 1, neon_fmul_4s(read_vec(Rn, 1), read_vec(Rm, 1)));
    }
  }
}

insn neon_fmul_2d {
  encoding "0" "1" "101110" "01" "1" Rm:5 "110111" Rn:5 Rd:5
  asm "fmul v{Rd:dec}.2d, v{Rn:dec}.2d, v{Rm:dec}.2d"
  semantics {
    write_vec(Rd, 1, neon_fmul_2d(vec[Rn], vec[Rm]));
  }
}

insn neon_fdiv_2s_4s {
  encoding "0" Q:1 "101110" "00" "1" Rm:5 "111111" Rn:5 Rd:5
  asm "fdiv {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fdiv_2s(read_vec(Rn, 0), read_vec(Rm, 0)));
    } else {
      write_vec(Rd, 1, neon_fdiv_4s(read_vec(Rn, 1), read_vec(Rm, 1)));
    }
  }
}

insn neon_fdiv_2d {
  encoding "0" "1" "101110" "01" "1" Rm:5 "111111" Rn:5 Rd:5
  asm "fdiv v{Rd:dec}.2d, v{Rn:dec}.2d, v{Rm:dec}.2d"
  semantics {
    write_vec(Rd, 1, neon_fdiv_2d(vec[Rn], vec[Rm]));
  }
}

insn neon_fsqrt_2s_4s {
  encoding "0" Q:1 "101110" "10" "1" "00001" "111110" Rn:5 Rd:5
  asm "fsqrt {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fsqrt_2s(read_vec(Rn, 0)));
    } else {
      write_vec(Rd, 1, neon_fsqrt_4s(read_vec(Rn, 1)));
    }
  }
}

insn neon_fsqrt_2d {
  encoding "0" "1" "101110" "11" "1" "00001" "111110" Rn:5 Rd:5
  asm "fsqrt v{Rd:dec}.2d, v{Rn:dec}.2d"
  semantics {
    vec[Rd] = neon_fsqrt_2d(vec[Rn]);
  }
}

insn neon_fcmeq_2s_4s {
  encoding "0" Q:1 "001110" "00" "1" Rm:5 "111001" Rn:5 Rd:5
  asm "fcmeq {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    if Q == 0 {
      write_vec(Rd, 0, neon_fcmeq_2s(read_vec(Rn, 0), read_vec(Rm, 0)));
    } else {
      write_vec(Rd, 1, neon_fcmeq_4s(read_vec(Rn, 1), read_vec(Rm, 1)));
    }
  }
}

insn neon_fcmeq_2d {
  encoding "0" "1" "001110" "01" "1" Rm:5 "111001" Rn:5 Rd:5
  asm "fcmeq v{Rd:dec}.2d, v{Rn:dec}.2d, v{Rm:dec}.2d"
  semantics {
    vec[Rd] = neon_fcmeq_2d(vec[Rn], vec[Rm]);
  }
}

// FABS/FNEG are exact sign-bit transforms, including for NaN payloads.
insn neon_fabs_2s_4s {
  encoding "0" Q:1 "001110" "10" "1" "00000" "111110" Rn:5 Rd:5
  asm "fabs {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    // The mask is built one 64-bit half at a time for the reason given where
    // write_dup64 is defined: an xspec integer is 64 bits, so asking
    // replicate_int for a 128-bit mask silently yields a 64-bit one, and the
    // zero-extension that follows would clear the lanes it was meant to keep.
    let half = imm(replicate_int(0x7fffffff, 32, 64), 64);
    if Q == 1 {
      write_vec(Rd, 1, read_vec(Rn, 1) & concat(half, half));
    } else {
      write_vec(Rd, 0, read_vec(Rn, 0) & half);
    }
  }
}

insn neon_fneg_2s_4s {
  encoding "0" Q:1 "101110" "10" "1" "00000" "111110" Rn:5 Rd:5
  asm "fneg {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    let half = imm(replicate_int(0x80000000, 32, 64), 64);
    if Q == 1 {
      write_vec(Rd, 1, read_vec(Rn, 1) ^ concat(half, half));
    } else {
      write_vec(Rd, 0, read_vec(Rn, 0) ^ half);
    }
  }
}

insn neon_fabs_2d {
  encoding "0" "1" "001110" "11" "1" "00000" "111110" Rn:5 Rd:5
  asm "fabs v{Rd:dec}.2d, v{Rn:dec}.2d"
  semantics {
    vec[Rd] = vec[Rn] & imm(replicate_int(0x7fffffffffffffff, 64, 128), 128);
  }
}

insn neon_fneg_2d {
  encoding "0" "1" "101110" "11" "1" "00000" "111110" Rn:5 Rd:5
  asm "fneg v{Rd:dec}.2d, v{Rn:dec}.2d"
  semantics {
    vec[Rd] = vec[Rn] ^ imm(replicate_int(0x8000000000000000, 64, 128), 128);
  }
}

// ---------------------------------------------------------------------------
// Advanced SIMD logical (two-register miscellaneous), 8B / 16B.
// These operate on the complete D or Q bitstring, so no lane helper is needed.
// ---------------------------------------------------------------------------

insn neon_and {
  encoding "0" Q:1 "001110001" Rm:5 "000111" Rn:5 Rd:5
  asm "and {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, read_vec(Rn, Q) & read_vec(Rm, Q));
  }
}

insn neon_bic {
  encoding "0" Q:1 "001110011" Rm:5 "000111" Rn:5 Rd:5
  asm "bic {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, read_vec(Rn, Q) & ~read_vec(Rm, Q));
  }
}

insn neon_orr {
  encoding "0" Q:1 "001110101" Rm:5 "000111" Rn:5 Rd:5
  asm "orr {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, read_vec(Rn, Q) | read_vec(Rm, Q));
  }
}

insn neon_orn {
  encoding "0" Q:1 "001110111" Rm:5 "000111" Rn:5 Rd:5
  asm "orn {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, read_vec(Rn, Q) | ~read_vec(Rm, Q));
  }
}

insn neon_eor {
  encoding "0" Q:1 "101110001" Rm:5 "000111" Rn:5 Rd:5
  asm "eor {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, read_vec(Rn, Q) ^ read_vec(Rm, Q));
  }
}

// ARMv8.2 SHA-3 helpers operate on the full 128-bit vector.
insn neon_eor3 {
  encoding "11001110000" Rm:5 "0" Ra:5 Rn:5 Rd:5
  asm "eor3 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}, {Ra:vreg(128)}"
  semantics {
    vec[Rd] = vec[Rn] ^ vec[Rm] ^ vec[Ra];
  }
}

insn neon_bcax {
  encoding "11001110001" Rm:5 "0" Ra:5 Rn:5 Rd:5
  asm "bcax {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}, {Ra:vreg(128)}"
  semantics {
    vec[Rd] = vec[Rn] ^ (vec[Rm] & ~vec[Ra]);
  }
}

fn ror64(v: bits(64), amount: int) -> bits(64) {
  if amount == 0 {
    return v;
  } else {
    return (v >> imm(amount, 64)) | (v << imm(64 - amount, 64));
  }
}

insn neon_xar {
  encoding "11001110100" Rm:5 imm6:6 Rn:5 Rd:5
  asm "xar {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}, #{imm6:dec}"
  semantics {
    let mixed = vec[Rn] ^ vec[Rm];
    vec[Rd] = concat(ror64(extract(mixed, 64, 64), imm6),
                     ror64(extract(mixed, 0, 64), imm6));
  }
}

insn neon_bsl {
  encoding "0" Q:1 "101110011" Rm:5 "000111" Rn:5 Rd:5
  asm "bsl {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let mask = read_vec(Rd, Q);
    write_vec(Rd, Q, (read_vec(Rn, Q) & mask) | (read_vec(Rm, Q) & ~mask));
  }
}

insn neon_bit {
  encoding "0" Q:1 "101110101" Rm:5 "000111" Rn:5 Rd:5
  asm "bit {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let old = read_vec(Rd, Q);
    let mask = read_vec(Rm, Q);
    write_vec(Rd, Q, (read_vec(Rn, Q) & mask) | (old & ~mask));
  }
}

insn neon_bif {
  encoding "0" Q:1 "101110111" Rm:5 "000111" Rn:5 Rd:5
  asm "bif {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let old = read_vec(Rd, Q);
    let mask = read_vec(Rm, Q);
    write_vec(Rd, Q, (read_vec(Rn, Q) & ~mask) | (old & mask));
  }
}

insn neon_mvn {
  encoding "0" Q:1 "101110" "00" "100000" "010110" Rn:5 Rd:5
  asm "mvn {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, ~read_vec(Rn, Q));
  }
}

// ---------------------------------------------------------------------------
// Advanced SIMD three-same integer: ADD/SUB 8B/16B, 4H/8H, 2S/4S, 2D.
// ---------------------------------------------------------------------------

insn neon_add_lanes {
  encoding "0" Q:1 "001110" size:2 "1" Rm:5 "100001" Rn:5 Rd:5
  require Q == 1 || size != 3;
  asm "add {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, add_lanes(Q, 8 << size, read_vec(Rn, Q), read_vec(Rm, Q)));
  }
}

// XTN and XTN2 differ only in where the narrowed half lands: XTN writes the
// low half and zeroes the rest, XTN2 writes the high half and leaves the low
// half alone. The element arrangement has to appear literally in each
// mnemonic, so the three source widths get a rule apiece.
insn neon_xtn_8b {
  encoding "0" "0" "0" "01110" "00" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn {Rd:vreg(64)}.8b, {Rn:vreg(128)}.8h"
  semantics {
    write_vec(Rd, 0, xtn8_64(vec[Rn]));
  }
}

insn neon_xtn_4h {
  encoding "0" "0" "0" "01110" "01" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn {Rd:vreg(64)}.4h, {Rn:vreg(128)}.4s"
  semantics {
    write_vec(Rd, 0, xtn16_64(vec[Rn]));
  }
}

insn neon_xtn_2s {
  encoding "0" "0" "0" "01110" "10" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn {Rd:vreg(64)}.2s, {Rn:vreg(128)}.2d"
  semantics {
    write_vec(Rd, 0, xtn32_64(vec[Rn]));
  }
}

insn neon_xtn2_16b {
  encoding "0" "1" "0" "01110" "00" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn2 {Rd:vreg(128)}.16b, {Rn:vreg(128)}.8h"
  semantics {
    vec[Rd] = concat(xtn8_64(vec[Rn]), extract(vec[Rd], 0, 64));
  }
}

insn neon_xtn2_8h {
  encoding "0" "1" "0" "01110" "01" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn2 {Rd:vreg(128)}.8h, {Rn:vreg(128)}.4s"
  semantics {
    vec[Rd] = concat(xtn16_64(vec[Rn]), extract(vec[Rd], 0, 64));
  }
}

insn neon_xtn2_4s {
  encoding "0" "1" "0" "01110" "10" "10000" "10010" "10" Rn:5 Rd:5
  asm "xtn2 {Rd:vreg(128)}.4s, {Rn:vreg(128)}.2d"
  semantics {
    vec[Rd] = concat(xtn32_64(vec[Rn]), extract(vec[Rd], 0, 64));
  }
}

insn neon_mul_lanes {
  encoding "0" Q:1 "001110" size:2 "1" Rm:5 "100111" Rn:5 Rd:5
  require size != 3;
  asm "mul {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, mul_lanes(Q, 8 << size, read_vec(Rn, Q), read_vec(Rm, Q)));
  }
}

insn neon_mla_lanes {
  encoding "0" Q:1 "001110" size:2 "1" Rm:5 "100101" Rn:5 Rd:5
  require size != 3;
  asm "mla {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let product = mul_lanes(Q, 8 << size, read_vec(Rn, Q), read_vec(Rm, Q));
    write_vec(Rd, Q, add_lanes(Q, 8 << size, read_vec(Rd, Q), product));
  }
}

insn neon_mls_lanes {
  encoding "0" Q:1 "101110" size:2 "1" Rm:5 "100101" Rn:5 Rd:5
  require size != 3;
  asm "mls {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let product = mul_lanes(Q, 8 << size, read_vec(Rn, Q), read_vec(Rm, Q));
    write_vec(Rd, Q, sub_lanes(Q, 8 << size, read_vec(Rd, Q), product));
  }
}

insn neon_umull_lanes {
  encoding "00" "101110" size:2 "1" Rm:5 "110000" Rn:5 Rd:5
  require size != 3;
  asm "umull {Rd:vreg(128)}, {Rn:vreg(64)}, {Rm:vreg(64)}"
  semantics {
    vec[Rd] = umull_lanes(8 << size, vec[Rn].d, vec[Rm].d);
  }
}

insn neon_umull2_lanes {
  encoding "01" "101110" size:2 "1" Rm:5 "110000" Rn:5 Rd:5
  require size != 3;
  asm "umull2 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    vec[Rd] = umull_lanes(8 << size, extract(vec[Rn], 64, 64),
                          extract(vec[Rm], 64, 64));
  }
}

insn neon_sub_lanes {
  encoding "0" Q:1 "101110" size:2 "1" Rm:5 "100001" Rn:5 Rd:5
  require Q == 1 || size != 3;
  asm "sub {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q, sub_lanes(Q, 8 << size, read_vec(Rn, Q), read_vec(Rm, Q)));
  }
}

insn neon_cmhi_lanes {
  encoding "0" Q:1 "101110" size:2 "1" Rm:5 "001101" Rn:5 Rd:5
  require Q == 1 || size != 3;
  asm "cmhi {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let low = cmhi_half(8 << size, vec[Rn].d, vec[Rm].d);
    if Q == 1 {
      vec[Rd] = concat(
          cmhi_half(8 << size, extract(vec[Rn], 64, 64),
                    extract(vec[Rm], 64, 64)),
          low);
    } else {
      vec[Rd].d = low;
    }
  }
}

insn neon_cmhs_lanes {
  encoding "0" Q:1 "101110" size:2 "1" Rm:5 "001111" Rn:5 Rd:5
  require Q == 1 || size != 3;
  asm "cmhs {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, {Rm:vreg(64 << Q)}"
  semantics {
    let low = ~cmhi_half(8 << size, vec[Rm].d, vec[Rn].d);
    if Q == 1 {
      vec[Rd] = concat(
          ~cmhi_half(8 << size, extract(vec[Rm], 64, 64),
                     extract(vec[Rn], 64, 64)),
          low);
    } else {
      vec[Rd].d = low;
    }
  }
}

insn neon_cmhs_scalar_d {
  encoding "01" "111110" "11" "1" Rm:5 "001111" Rn:5 Rd:5
  asm "cmhs d{Rd:dec}, d{Rn:dec}, d{Rm:dec}"
  semantics {
    vec[Rd].d = ~cmhi64(vec[Rm].d, vec[Rn].d);
  }
}

insn neon_cmlt_b {
  encoding "0" Q:1 "001110" "00" "100000" "101010" Rn:5 Rd:5
  asm "cmlt {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, #0"
  semantics {
    if Q == 1 {
      vec[Rd] = concat(cmlt_8b(extract(vec[Rn], 64, 64)),
                       cmlt_8b(extract(vec[Rn], 0, 64)));
    } else {
      vec[Rd].d = cmlt_8b(vec[Rn].d);
    }
  }
}

insn neon_uzp1 {
  encoding "01" "001110" size:2 "0" Rm:5 "000110" Rn:5 Rd:5
  require size != 3;
  asm "uzp1 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    if size == 0 {
      vec[Rd] = concat(even_bytes128(vec[Rm]), even_bytes128(vec[Rn]));
    } else if size == 1 {
      vec[Rd] = concat(even_halfwords128(vec[Rm]),
                       even_halfwords128(vec[Rn]));
    } else {
      vec[Rd] = concat(even_words128(vec[Rm]), even_words128(vec[Rn]));
    }
  }
}

insn neon_uzp2 {
  encoding "01" "001110" size:2 "0" Rm:5 "010110" Rn:5 Rd:5
  require size != 3;
  asm "uzp2 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    if size == 0 {
      vec[Rd] = concat(odd_bytes128(vec[Rm]), odd_bytes128(vec[Rn]));
    } else if size == 1 {
      vec[Rd] = concat(odd_halfwords128(vec[Rm]),
                       odd_halfwords128(vec[Rn]));
    } else {
      vec[Rd] = concat(odd_words128(vec[Rm]), odd_words128(vec[Rn]));
    }
  }
}

insn neon_xtn {
  encoding "00" "001110" size:2 "1" "00001" "001010" Rn:5 Rd:5
  require size == 0 || size == 1;
  asm "xtn {Rd:vreg(64)}, {Rn:vreg(128)}"
  semantics {
    if size == 0 {
      vec[Rd] = zext(narrow_8h_to_8b(vec[Rn]), 128);
    } else {
      vec[Rd] = zext(narrow_4s_to_4h(vec[Rn]), 128);
    }
  }
}

insn neon_uaddw_4s {
  encoding "00" "101110" "01" "1" Rm:5 "000100" Rn:5 Rd:5
  asm "uaddw {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(64)}"
  semantics {
    vec[Rd] = uaddw_4s_4h(vec[Rn], vec[Rm].d);
  }
}

insn neon_uaddw2_4s {
  encoding "01" "101110" "01" "1" Rm:5 "000100" Rn:5 Rd:5
  asm "uaddw2 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    vec[Rd] = uaddw_4s_4h(vec[Rn], extract(vec[Rm], 64, 64));
  }
}

insn neon_usubw_lanes {
  encoding "00" "101110" size:2 "1" Rm:5 "001100" Rn:5 Rd:5
  require size != 3;
  asm "usubw {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(64)}"
  semantics {
    vec[Rd] = usubw_lanes(8 << size, vec[Rn], vec[Rm].d);
  }
}

insn neon_usubw2_lanes {
  encoding "01" "101110" size:2 "1" Rm:5 "001100" Rn:5 Rd:5
  require size != 3;
  asm "usubw2 {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    vec[Rd] = usubw_lanes(8 << size, vec[Rn],
                          extract(vec[Rm], 64, 64));
  }
}

// Advanced SIMD shift-by-immediate. `immh:immb` encodes element size and
// amount: SHL uses `lane_bits + amount`; USHR uses `2*lane_bits - amount`.
insn neon_shl_lanes {
  encoding "0" Q:1 "001111" "0" immh:4 immb:3 "010101" Rn:5 Rd:5
  require immh != 0 && (Q == 1 || immh != 8);
  asm "shl {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, #{((immh << 3) | immb) - (8 << highestbit_int(immh)):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = ((immh << 3) | immb) - lane_bits;
    write_vec(Rd, Q, shl_lanes(Q, lane_bits, read_vec(Rn, Q), amount));
  }
}

insn neon_ushr_lanes {
  encoding "0" Q:1 "101111" "0" immh:4 immb:3 "000001" Rn:5 Rd:5
  require immh != 0 && (Q == 1 || immh != 8);
  asm "ushr {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, #{(16 << highestbit_int(immh)) - ((immh << 3) | immb):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = (lane_bits << 1) - ((immh << 3) | immb);
    write_vec(Rd, Q, ushr_lanes(Q, lane_bits, read_vec(Rn, Q), amount));
  }
}

insn neon_usra_lanes {
  encoding "0" Q:1 "101111" "0" immh:4 immb:3 "000101" Rn:5 Rd:5
  require immh != 0 && (Q == 1 || immh != 8);
  asm "usra {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}, #{(16 << highestbit_int(immh)) - ((immh << 3) | immb):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = (lane_bits << 1) - ((immh << 3) | immb);
    let shifted = ushr_lanes(Q, lane_bits, read_vec(Rn, Q), amount);
    write_vec(Rd, Q, add_lanes(Q, lane_bits, read_vec(Rd, Q), shifted));
  }
}

// Unsigned shift left long. Q selects the low (USHLL) or high (USHLL2)
// 64-bit half of the source; every lane widens to twice its original width.
insn neon_ushll_lanes {
  encoding "00" "101111" "0" immh:4 immb:3 "101001" Rn:5 Rd:5
  require immh != 0 && immh < 8;
  asm "ushll {Rd:vreg(128)}, {Rn:vreg(64)}, #{((immh << 3) | immb) - (8 << highestbit_int(immh)):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = ((immh << 3) | immb) - lane_bits;
    vec[Rd] = ushll_lanes(lane_bits, vec[Rn].d, amount);
  }
}

insn neon_ushll2_lanes {
  encoding "01" "101111" "0" immh:4 immb:3 "101001" Rn:5 Rd:5
  require immh != 0 && immh < 8;
  asm "ushll2 {Rd:vreg(128)}, {Rn:vreg(128)}, #{((immh << 3) | immb) - (8 << highestbit_int(immh)):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = ((immh << 3) | immb) - lane_bits;
    vec[Rd] = ushll_lanes(lane_bits, extract(vec[Rn], 64, 64), amount);
  }
}

insn neon_sshll_lanes {
  encoding "00" "001111" "0" immh:4 immb:3 "101001" Rn:5 Rd:5
  require immh != 0 && immh < 8;
  asm "sshll {Rd:vreg(128)}, {Rn:vreg(64)}, #{((immh << 3) | immb) - (8 << highestbit_int(immh)):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = ((immh << 3) | immb) - lane_bits;
    vec[Rd] = sshll_lanes(lane_bits, vec[Rn].d, amount);
  }
}

insn neon_sshll2_lanes {
  encoding "01" "001111" "0" immh:4 immb:3 "101001" Rn:5 Rd:5
  require immh != 0 && immh < 8;
  asm "sshll2 {Rd:vreg(128)}, {Rn:vreg(128)}, #{((immh << 3) | immb) - (8 << highestbit_int(immh)):dec}"
  semantics {
    let lane_bits = 8 << highestbit_int(immh);
    let amount = ((immh << 3) | immb) - lane_bits;
    vec[Rd] = sshll_lanes(lane_bits, extract(vec[Rn], 64, 64), amount);
  }
}

// Shift left long. Unlike USHLL, SHLL has no encoded shift amount: it always
// shifts by the source element width.
insn neon_shll_lanes {
  encoding "00" "101110" size:2 "100001001110" Rn:5 Rd:5
  require size != 3;
  asm "shll {Rd:vreg(128)}, {Rn:vreg(64)}, #{8 << size:dec}"
  semantics {
    let lane_bits = 8 << size;
    vec[Rd] = ushll_lanes(lane_bits, vec[Rn].d, lane_bits);
  }
}

insn neon_shll2_lanes {
  encoding "01" "101110" size:2 "100001001110" Rn:5 Rd:5
  require size != 3;
  asm "shll2 {Rd:vreg(128)}, {Rn:vreg(128)}, #{8 << size:dec}"
  semantics {
    let lane_bits = 8 << size;
    vec[Rd] = ushll_lanes(lane_bits, extract(vec[Rn], 64, 64), lane_bits);
  }
}

// Advanced SIMD modified immediate. cmode=1110 / op=1 is the 64-bit byte-mask
// form (`movi vN.2d, #imm` / `movi dN, #imm`): each of the eight imm8 bits
// becomes 0x00 or 0xff in the corresponding byte of a 64-bit lane.
fn movi_byte_mask64(imm8: int) -> int {
  return ((imm8 >> 0) & 1) * 0xff
       | (((imm8 >> 1) & 1) * 0xff) << 8
       | (((imm8 >> 2) & 1) * 0xff) << 16
       | (((imm8 >> 3) & 1) * 0xff) << 24
       | (((imm8 >> 4) & 1) * 0xff) << 32
       | (((imm8 >> 5) & 1) * 0xff) << 40
       | (((imm8 >> 6) & 1) * 0xff) << 48
       | (((imm8 >> 7) & 1) * 0xff) << 56;
}

insn neon_movi_d {
  encoding "0" Q:1 "1" "01111" "00000" abc:3 "1110" "01" defgh:5 Rd:5
  asm "movi {Rd:vreg(64 << Q)}, #{movi_byte_mask64((abc << 5) | defgh):hex}"
  semantics {
    let lane = imm(movi_byte_mask64((abc << 5) | defgh), 64);
    if Q == 1 {
      vec[Rd] = concat(lane, lane);
    } else {
      vec[Rd].d = lane;
    }
  }
}

// Byte replicate (`movi vN.16b/#8b, #imm8`). cmode=1110 / op=0.
insn neon_movi_b {
  encoding "0" Q:1 "0" "01111" "00000" abc:3 "1110" "01" defgh:5 Rd:5
  asm "movi {Rd:vreg(64 << Q)}, #{(abc << 5) | defgh:hex}"
  semantics {
    write_dup64(Rd, Q, dup8_64(imm((abc << 5) | defgh, 8)));
  }
}

// The shifted modified-immediate forms. One imm8 is placed at one of four byte
// positions within a 32-bit lane, or one of two within a 16-bit lane, and the
// lane is then replicated across the register. `op` picks between MOVI and
// MVNI, which differ only by inverting the lane, so they share a rule rather
// than restating the placement twice.
//
// The whole constant is decode-time, so each of these lifts to a single
// immediate no matter how elaborate the encoding was.

// MOVI and MVNI differ only by inverting the lane, but they need separate
// rules because the mnemonic is part of what a rule declares and the asm
// syntax has no way to choose one from a field. The placement arithmetic is
// stated once, in the writer helpers below.

fn write_splat32(n: int(0..31), q: int(0..1), lane: bits(32)) {
  write_dup64(n, q, dup32_64(lane));
}

fn write_splat16(n: int(0..31), q: int(0..1), lane: bits(16)) {
  write_dup64(n, q, dup16_64(lane));
}

insn neon_movi_shifted_32 {
  encoding "0" Q:1 "0" "0111100000" abc:3 "0" cc:2 "0" "0" "1" defgh:5 Rd:5
  asm "movi {Rd:vreg(64 << Q)}.4s, #{(abc << 5) | defgh:hex}[, lsl #{cc * 8:dec}]"
  semantics {
    write_splat32(Rd, Q, imm(((abc << 5) | defgh) << (cc * 8), 32));
  }
}

insn neon_mvni_shifted_32 {
  encoding "0" Q:1 "1" "0111100000" abc:3 "0" cc:2 "0" "0" "1" defgh:5 Rd:5
  asm "mvni {Rd:vreg(64 << Q)}.4s, #{(abc << 5) | defgh:hex}[, lsl #{cc * 8:dec}]"
  semantics {
    write_splat32(Rd, Q, ~imm(((abc << 5) | defgh) << (cc * 8), 32));
  }
}

insn neon_movi_shifted_16 {
  encoding "0" Q:1 "0" "0111100000" abc:3 "10" c:1 "0" "0" "1" defgh:5 Rd:5
  asm "movi {Rd:vreg(64 << Q)}.8h, #{(abc << 5) | defgh:hex}[, lsl #{c * 8:dec}]"
  semantics {
    write_splat16(Rd, Q, imm((((abc << 5) | defgh) << (c * 8)) & 0xffff, 16));
  }
}

insn neon_mvni_shifted_16 {
  encoding "0" Q:1 "1" "0111100000" abc:3 "10" c:1 "0" "0" "1" defgh:5 Rd:5
  asm "mvni {Rd:vreg(64 << Q)}.8h, #{(abc << 5) | defgh:hex}[, lsl #{c * 8:dec}]"
  semantics {
    write_splat16(Rd, Q, ~imm((((abc << 5) | defgh) << (c * 8)) & 0xffff, 16));
  }
}

// The "shifting ones" form: the imm8 moves up by one or two bytes and the
// vacated low bits come in as ones rather than zeros. It exists because the
// constants it builds -- a run of ones ending at a byte boundary -- are what
// masking and saturating code actually wants.
insn neon_movi_msl_32 {
  encoding "0" Q:1 "0" "0111100000" abc:3 "110" c:1 "0" "1" defgh:5 Rd:5
  asm "movi {Rd:vreg(64 << Q)}.4s, #{(abc << 5) | defgh:hex}, msl #{8 << c:dec}"
  semantics {
    write_splat32(Rd, Q,
                  imm((((abc << 5) | defgh) << (8 << c)) | ones_int(8 << c),
                      32));
  }
}

insn neon_mvni_msl_32 {
  encoding "0" Q:1 "1" "0111100000" abc:3 "110" c:1 "0" "1" defgh:5 Rd:5
  asm "mvni {Rd:vreg(64 << Q)}.4s, #{(abc << 5) | defgh:hex}, msl #{8 << c:dec}"
  semantics {
    write_splat32(Rd, Q,
                  ~imm((((abc << 5) | defgh) << (8 << c)) | ones_int(8 << c),
                       32));
  }
}

// ---------------------------------------------------------------------------
// Advanced SIMD copy: DUP by element, UMOV
// ---------------------------------------------------------------------------
//
// These share one encoding whose `imm5` field names both the element size and
// the lane, by the position of its lowest set bit. Rather than decode that
// position arithmetically, each size writes the pattern into its own encoding:
// the lane index then arrives as a field of the right width and is provably in
// range, which a computed bit-scan would not be.

insn neon_dup_elem_b {
  encoding "0" Q:1 "0" "01110000" idx:4 "1" "0" "0000" "1" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}.b, {Rn:vreg(128)}.b[{idx:dec}]"
  semantics {
    write_dup64(Rd, Q, dup8_64(extract(vec[Rn], idx * 8, 8)));
  }
}

insn neon_dup_elem_h {
  encoding "0" Q:1 "0" "01110000" idx:3 "10" "0" "0000" "1" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}.h, {Rn:vreg(128)}.h[{idx:dec}]"
  semantics {
    write_dup64(Rd, Q, dup16_64(extract(vec[Rn], idx * 16, 16)));
  }
}

insn neon_dup_elem_s {
  encoding "0" Q:1 "0" "01110000" idx:2 "100" "0" "0000" "1" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}.s, {Rn:vreg(128)}.s[{idx:dec}]"
  semantics {
    write_dup64(Rd, Q, dup32_64(extract(vec[Rn], idx * 32, 32)));
  }
}

// Only the full-width form exists: replicating a 64-bit lane into a 64-bit
// register would be a plain move, and the architecture leaves Q clear here
// unallocated rather than spelling one.
insn neon_dup_elem_d {
  encoding "01" "0" "01110000" idx:1 "1000" "0" "0000" "1" Rn:5 Rd:5
  asm "dup {Rd:vreg(128)}.d, {Rn:vreg(128)}.d[{idx:dec}]"
  semantics {
    let lane = extract(vec[Rn], idx * 64, 64);
    vec[Rd] = concat(lane, lane);
  }
}

// UMOV moves one lane into a general register, zero-extended. The destination
// width is fixed by the element: everything below 64 bits lands in a W
// register, and only the D form uses an X.
insn neon_umov_b {
  encoding "00" "0" "01110000" idx:4 "1" "0" "0111" "1" Rn:5 Rd:5
  asm "umov {Rd:reg(0)}, {Rn:vreg(128)}.b[{idx:dec}]"
  semantics {
    write_gpr(Rd, 0, zext(extract(vec[Rn], idx * 8, 8), 32));
  }
}

insn neon_umov_h {
  encoding "00" "0" "01110000" idx:3 "10" "0" "0111" "1" Rn:5 Rd:5
  asm "umov {Rd:reg(0)}, {Rn:vreg(128)}.h[{idx:dec}]"
  semantics {
    write_gpr(Rd, 0, zext(extract(vec[Rn], idx * 16, 16), 32));
  }
}

insn neon_umov_s {
  encoding "00" "0" "01110000" idx:2 "100" "0" "0111" "1" Rn:5 Rd:5
  asm "umov {Rd:reg(0)}, {Rn:vreg(128)}.s[{idx:dec}]"
  semantics {
    write_gpr(Rd, 0, extract(vec[Rn], idx * 32, 32));
  }
}

insn neon_umov_d {
  encoding "01" "0" "01110000" idx:1 "1000" "0" "0111" "1" Rn:5 Rd:5
  asm "umov {Rd:reg(1)}, {Rn:vreg(128)}.d[{idx:dec}]"
  semantics {
    write_gpr(Rd, 1, extract(vec[Rn], idx * 64, 64));
  }
}

insn neon_dup_gpr_b {
  encoding "0" Q:1 "001110" "000" "00001" "000011" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}, {Rn:reg(0)}"
  semantics {
    let half = dup8_64(trunc(read_gpr(Rn, 0), 8));
    if Q == 1 {
      vec[Rd] = concat(half, half);
    } else {
      vec[Rd].d = half;
    }
  }
}

insn neon_dup_gpr_h {
  encoding "0" Q:1 "001110" "000" "00010" "000011" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}, {Rn:reg(0)}"
  semantics {
    let half = dup16_64(trunc(read_gpr(Rn, 0), 16));
    if Q == 1 {
      vec[Rd] = concat(half, half);
    } else {
      vec[Rd].d = half;
    }
  }
}

insn neon_dup_gpr_s {
  encoding "0" Q:1 "001110" "000" "00100" "000011" Rn:5 Rd:5
  asm "dup {Rd:vreg(64 << Q)}, {Rn:reg(0)}"
  semantics {
    let half = dup32_64(read_gpr(Rn, 0));
    if Q == 1 {
      vec[Rd] = concat(half, half);
    } else {
      vec[Rd].d = half;
    }
  }
}

fn insert_lane8(v: bits(128), lane: bits(8), index: int) -> bits(128) {
  let shift = index * 8;
  let mask = imm(ones_int(8) << shift, 128);
  return (v & ~mask) | (zext(lane, 128) << imm(shift, 128));
}

fn insert_lane16(v: bits(128), lane: bits(16), index: int) -> bits(128) {
  let shift = index * 16;
  let mask = imm(ones_int(16) << shift, 128);
  return (v & ~mask) | (zext(lane, 128) << imm(shift, 128));
}

fn insert_lane32(v: bits(128), lane: bits(32), index: int) -> bits(128) {
  let shift = index * 32;
  let mask = imm(ones_int(32) << shift, 128);
  return (v & ~mask) | (zext(lane, 128) << imm(shift, 128));
}

// EXT reads a window of the two sources laid end to end: `imm4` bytes are
// dropped off the bottom of Vn and the same number taken from the bottom of
// Vm to refill the top. The two slices therefore always add back to the
// register width, which is what the checker has to be shown.
//
// `imm4 == 0` is excluded because it would ask for a zero-width slice of Vm.
// It is also the one value with no shuffling to do, and the assembler spells
// it `mov` instead.
insn neon_ext_16b {
  encoding "01" "101110" "000" Rm:5 "0" imm4:4 "0" Rn:5 Rd:5
  require imm4 != 0;
  asm "ext {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}, #{imm4:dec}"
  semantics {
    vec[Rd] = concat(extract(vec[Rm], 0, imm4 * 8),
                     extract(vec[Rn], imm4 * 8, 128 - imm4 * 8));
  }
}

insn neon_ext_8b {
  encoding "00" "101110" "000" Rm:5 "0" "0" imm3:3 "0" Rn:5 Rd:5
  require imm3 != 0;
  asm "ext {Rd:vreg(64)}, {Rn:vreg(64)}, {Rm:vreg(64)}, #{imm3:dec}"
  semantics {
    vec[Rd].d = concat(extract(vec[Rm], 0, imm3 * 8),
                       extract(vec[Rn], imm3 * 8, 64 - imm3 * 8));
  }
}

fn cnt8(v: bits(8)) -> bits(8) {
  return popcount(v);
}

fn cnt64(v: bits(64)) -> bits(64) {
  return concat(
      concat(concat(cnt8(extract(v, 56, 8)), cnt8(extract(v, 48, 8))),
             concat(cnt8(extract(v, 40, 8)), cnt8(extract(v, 32, 8)))),
      concat(concat(cnt8(extract(v, 24, 8)), cnt8(extract(v, 16, 8))),
             concat(cnt8(extract(v, 8, 8)), cnt8(extract(v, 0, 8)))));
}

insn neon_cnt {
  encoding "0" Q:1 "001110" "00" "100000" "010110" Rn:5 Rd:5
  asm "cnt {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    if Q == 1 {
      vec[Rd] = concat(cnt64(extract(vec[Rn], 64, 64)), cnt64(trunc(vec[Rn], 64)));
    } else {
      vec[Rd].d = cnt64(vec[Rn].d);
    }
  }
}

// Unsigned add long across 8-byte vector: sum of bytes into H[0], rest zero.
insn neon_uaddlv_8b {
  encoding "00" "101110" "00" "110000" "001110" Rn:5 Rd:5
  asm "uaddlv h{Rd:dec}, v{Rn:dec}.8b"
  semantics {
    let src = vec[Rn].d;
    let sum = zext(extract(src, 0, 8), 16) + zext(extract(src, 8, 8), 16)
            + zext(extract(src, 16, 8), 16) + zext(extract(src, 24, 8), 16)
            + zext(extract(src, 32, 8), 16) + zext(extract(src, 40, 8), 16)
            + zext(extract(src, 48, 8), 16) + zext(extract(src, 56, 8), 16);
    vec[Rd].h = sum;
  }
}

// Integer add across lanes. The architectural scalar destination width follows
// the source element width, and the reduction wraps at that width.
insn neon_addv {
  encoding "0" Q:1 "001110" size:2 "110001" "101110" Rn:5 Rd:5
  require size != 3;
  require size != 2 || Q == 1;
  asm "addv {Rd:vreg(8 << size)}, {Rn:vreg(64 << Q)}"
  semantics {
    if size == 0 {
      let low = addv8_64(vec[Rn].d);
      vec[Rd].b = Q == 1
          ? low + addv8_64(extract(vec[Rn], 64, 64))
          : low;
    } else {
      if size == 1 {
        let low = addv16_64(vec[Rn].d);
        vec[Rd].h = Q == 1
            ? low + addv16_64(extract(vec[Rn], 64, 64))
            : low;
      } else {
        vec[Rd].s = addv32_64(vec[Rn].d)
                  + addv32_64(extract(vec[Rn], 64, 64));
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Encodings found by decoding every instruction word in a shipping arm64
// binary and diffing against this spec. Each one below was reached by real
// code, so the catch-all was turning a working trace into a dead end.
// ---------------------------------------------------------------------------

// DUP (general) completes the byte/halfword/word family already above. The
// 64-bit element size has no narrow form: imm5 `01000` only pairs with Q=1.
insn neon_dup_gpr_d {
  encoding "01" "001110" "000" "01000" "000011" Rn:5 Rd:5
  asm "dup {Rd:vreg(128)}, {Rn:reg(1)}"
  semantics {
    let half = read_gpr(Rn, 1);
    vec[Rd] = concat(half, half);
  }
}

// INS (element). imm5 encodes the destination element size and lane while
// imm4 encodes the source lane at the same size.
insn neon_ins_elem_b {
  encoding "01101110" "000" idxd:4 "1" "0" idxn:4 "1" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.b{idxd:dec}, {Rn:vreg(128)}.b{idxn:dec}"
  semantics {
    vec[Rd] = insert_lane8(vec[Rd], extract(vec[Rn], idxn * 8, 8), idxd);
  }
}

insn neon_ins_elem_h {
  encoding "01101110" "000" idxd:3 "10" "0" idxn:3 "0" "1" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.h{idxd:dec}, {Rn:vreg(128)}.h{idxn:dec}"
  semantics {
    vec[Rd] = insert_lane16(vec[Rd], extract(vec[Rn], idxn * 16, 16), idxd);
  }
}

insn neon_ins_elem_s {
  encoding "01101110" "000" idxd:2 "100" "0" idxn:2 "00" "1" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.s{idxd:dec}, {Rn:vreg(128)}.s{idxn:dec}"
  semantics {
    vec[Rd] = insert_lane32(vec[Rd], extract(vec[Rn], idxn * 32, 32), idxd);
  }
}

insn neon_ins_elem_d {
  encoding "01101110" "000" idxd:1 "1000" "0" idxn:1 "000" "1" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.d{idxd:dec}, {Rn:vreg(128)}.d{idxn:dec}"
  semantics {
    let src = extract(vec[Rn], idxn * 64, 64);
    if idxd == 1 {
      vec[Rd] = concat(src, extract(vec[Rd], 0, 64));
    } else {
      vec[Rd] = concat(extract(vec[Rd], 64, 64), src);
    }
  }
}

// INS (general) moves a W/X register into one vector lane and preserves every
// other lane.
insn neon_ins_gpr_b {
  encoding "01001110" "000" idx:4 "1" "000111" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.b{idx:dec}, {Rn:reg(0)}"
  semantics {
    vec[Rd] = insert_lane8(vec[Rd], trunc(read_gpr(Rn, 0), 8), idx);
  }
}

insn neon_ins_gpr_h {
  encoding "01001110" "000" idx:3 "10" "000111" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.h{idx:dec}, {Rn:reg(0)}"
  semantics {
    vec[Rd] = insert_lane16(vec[Rd], trunc(read_gpr(Rn, 0), 16), idx);
  }
}

insn neon_ins_gpr_s {
  encoding "01001110" "000" idx:2 "100" "000111" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.s{idx:dec}, {Rn:reg(0)}"
  semantics {
    vec[Rd] = insert_lane32(vec[Rd], read_gpr(Rn, 0), idx);
  }
}

insn neon_ins_gpr_d {
  encoding "01001110" "000" idx:1 "1000" "000111" Rn:5 Rd:5
  asm "mov {Rd:vreg(128)}.d{idx:dec}, {Rn:reg(1)}"
  semantics {
    let src = read_gpr(Rn, 1);
    if idx == 1 {
      vec[Rd] = concat(src, extract(vec[Rd], 0, 64));
    } else {
      vec[Rd] = concat(extract(vec[Rd], 64, 64), src);
    }
  }
}

insn neon_cmeq_zero_4s {
  encoding "01" "001110" "10" "10000" "01001" "10" Rn:5 Rd:5
  asm "cmeq {Rd:vreg(128)}, {Rn:vreg(128)}, #0"
  semantics {
    vec[Rd] = cmeq0_4s(vec[Rn]);
  }
}

fn rev64_bytes(v: bits(64)) -> bits(64) {
  return concat(
      concat(concat(extract(v, 0, 8), extract(v, 8, 8)),
             concat(extract(v, 16, 8), extract(v, 24, 8))),
      concat(concat(extract(v, 32, 8), extract(v, 40, 8)),
             concat(extract(v, 48, 8), extract(v, 56, 8))));
}

fn rev64_halfwords(v: bits(64)) -> bits(64) {
  return concat(
      concat(extract(v, 0, 16), extract(v, 16, 16)),
      concat(extract(v, 32, 16), extract(v, 48, 16)));
}

fn rev64_words(v: bits(64)) -> bits(64) {
  return concat(extract(v, 0, 32), extract(v, 32, 32));
}

fn rev64_lanes(lane_bits: int, v: bits(64)) -> bits(64) {
  if lane_bits == 8 {
    return rev64_bytes(v);
  } else if lane_bits == 16 {
    return rev64_halfwords(v);
  } else {
    return rev64_words(v);
  }
}

insn neon_rev64 {
  encoding "0" Q:1 "001110" size:2 "10000" "00000" "10" Rn:5 Rd:5
  require size != 3;
  asm "rev64 {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    let low = rev64_lanes(8 << size, vec[Rn].d);
    if Q == 1 {
      vec[Rd] = concat(rev64_lanes(8 << size,
                                   extract(vec[Rn], 64, 64)),
                       low);
    } else {
      vec[Rd].d = low;
    }
  }
}

insn neon_ushl_4s {
  encoding "01" "101110" "10" "1" Rm:5 "010001" Rn:5 Rd:5
  asm "ushl {Rd:vreg(128)}, {Rn:vreg(128)}, {Rm:vreg(128)}"
  semantics {
    vec[Rd] = ushl_4s(vec[Rn], vec[Rm]);
  }
}

insn neon_neg_lanes {
  encoding "0" Q:1 "101110" size:2 "10000" "01011" "10" Rn:5 Rd:5
  require Q == 1 || size != 3;
  asm "neg {Rd:vreg(64 << Q)}, {Rn:vreg(64 << Q)}"
  semantics {
    write_vec(Rd, Q,
              sub_lanes(Q, 8 << size, imm(0, 64 << Q), read_vec(Rn, Q)));
  }
}

// ORR and BIC by immediate share the MOVI encoding space; `op` picks between
// them and the immediate is splatted across lanes the same way. Unlike MOVI
// they read the destination, so they cannot go through write_splat*.
insn neon_orr_imm_16 {
  encoding "0" Q:1 "0" "0111100000" abc:3 "10" c:1 "1" "0" "1" defgh:5 Rd:5
  asm "orr {Rd:vreg(64 << Q)}.8h, #{(abc << 5) | defgh:hex}[, lsl #{c * 8:dec}]"
  semantics {
    let half = dup16_64(imm((((abc << 5) | defgh) << (c * 8)) & 0xffff, 16));
    if Q == 1 {
      vec[Rd] = vec[Rd] | concat(half, half);
    } else {
      write_vec(Rd, 0, vec[Rd].d | half);
    }
  }
}

insn neon_bic_imm_32 {
  encoding "0" Q:1 "1" "0111100000" abc:3 "0" cc:2 "1" "0" "1" defgh:5 Rd:5
  asm "bic {Rd:vreg(64 << Q)}.4s, #{(abc << 5) | defgh:hex}[, lsl #{cc * 8:dec}]"
  semantics {
    let half = dup32_64(~imm(((abc << 5) | defgh) << (cc * 8), 32));
    if Q == 1 {
      vec[Rd] = vec[Rd] & concat(half, half);
    } else {
      write_vec(Rd, 0, vec[Rd].d & half);
    }
  }
}

// Permutes and lane moves remain unmodelled. They need a value-dependent
// sequence of slices, while this DSL cannot prove that
// `shift + (width - shift) == width` for field-dependent EXT. Do not pretend
// that this proof gap has value semantics.
//
// The remaining SIMD and floating-point encodings stop explicitly. A real rule
// above wins over this negative-priority catch-all; no unsupported instruction
// may silently masquerade as a successfully executed opaque intrinsic.
//
// The priority is negative so that any real rule added later wins without the
// catch-alls having to be edited.

// Bits 28..25 select the top-level encoding group. `x111` is the whole of
// scalar floating point and Advanced SIMD.
insn simd_fp_unmodelled {
  encoding hi:4 "111" rest:25
  priority -100
  asm "simd #{opcode:hex}"
  semantics {
    unimplemented("aarch64 Scalar FP or Advanced SIMD/NEON");
  }
}

// `x1x0` is the whole of loads and stores. What reaches here is the vector and
// exclusive forms the rules above do not cover. Naming it separately from the
// SIMD catch-all keeps `xdec coverage` honest about which of the two is growing.
insn memory_unmodelled {
  encoding hi:3 g28:1 "1" g26:1 "0" rest:25
  priority -110
  asm "ldst #{opcode:hex}"
  semantics {
    intrinsic("aarch64.memory", imm(opcode, 32));
  }
}

insn udf_trap {
  encoding "0000000000000000" imm16:16
  asm "udf #{imm16:hex}"
  semantics {
    unimplemented("udf");
  }
}
