// Loads and stores of SIMD and floating-point registers.
//
// Separate from the general-purpose forms because the register file differs, not
// because the addressing does; the modes and their scaling mirror the other file
// rule for rule. These are modelled while the vector arithmetic is not, since a
// spilled vector register is an ordinary memory access and the stack analysis
// has to see it.
// ---------------------------------------------------------------------------
// Loads and stores: SIMD and floating point registers
// ---------------------------------------------------------------------------
//
// The arithmetic on V registers is still an intrinsic, but the moves between
// them and memory are not, because they are ordinary memory accesses and the
// stack analysis has to see them. A prologue that spills q8..q15 and an epilogue
// that reloads them are, to anything reasoning about frames, eight stores and
// eight loads; leaving them opaque would make every such frame unreadable.
//
// One rule covers all four scalar widths. A load writes the whole 128-bit
// register zero-extended, which is what the architecture does and what removes
// the need to name a view: `ldr s0` is `v0 = zext(load(addr, 32), 128)`.

fn replace_low_byte(v: bits(128), lane: int(0..7), b: bits(8)) -> bits(128) {
  let shift = lane * 8;
  let keep = imm(ones_int(64) ^ (0xff << shift), 64);
  let low = (extract(v, 0, 64) & keep) |
            (zext(b, 64) << imm(shift, 64));
  return concat(extract(v, 64, 64), low);
}

fn structure_even_bytes64(v: bits(64)) -> bits(32) {
  return concat(concat(extract(v, 48, 8), extract(v, 32, 8)),
                concat(extract(v, 16, 8), extract(v, 0, 8)));
}

fn structure_odd_bytes64(v: bits(64)) -> bits(32) {
  return concat(concat(extract(v, 56, 8), extract(v, 40, 8)),
                concat(extract(v, 24, 8), extract(v, 8, 8)));
}

fn structure_even_bytes128(v: bits(128)) -> bits(64) {
  return concat(structure_even_bytes64(extract(v, 64, 64)),
                structure_even_bytes64(extract(v, 0, 64)));
}

fn structure_odd_bytes128(v: bits(128)) -> bits(64) {
  return concat(structure_odd_bytes64(extract(v, 64, 64)),
                structure_odd_bytes64(extract(v, 0, 64)));
}

insn str_fp_imm_unsigned {
  encoding sz:2 "11110100" imm12:12 Rn:5 Rt:5
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{imm12 << sz:hex}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(imm12 << sz, 64), trunc(vec[Rt], 8 << sz));
  }
}

insn ldr_fp_imm_unsigned {
  encoding sz:2 "11110101" imm12:12 Rn:5 Rt:5
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{imm12 << sz:hex}\]"
  semantics {
    vec[Rt] = zext(load(read_gpr_sp(Rn, 1) + imm(imm12 << sz, 64), 8 << sz), 128);
  }
}

insn str_q_imm_unsigned {
  encoding "0011110110" imm12:12 Rn:5 Rt:5
  asm "str {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{imm12 << 4:hex}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(imm12 << 4, 64), vec[Rt]);
  }
}

insn ldr_q_imm_unsigned {
  encoding "0011110111" imm12:12 Rn:5 Rt:5
  asm "ldr {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{imm12 << 4:hex}\]"
  semantics {
    vec[Rt] = load(read_gpr_sp(Rn, 1) + imm(imm12 << 4, 64), 128);
  }
}

insn stur_fp {
  encoding sz:2 "111100" "00" "0" imm9:9 "00" Rn:5 Rt:5
  asm "stur {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), trunc(vec[Rt], 8 << sz));
  }
}

insn ldur_fp {
  encoding sz:2 "111100" "01" "0" imm9:9 "00" Rn:5 Rt:5
  asm "ldur {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    vec[Rt] = zext(load(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), 8 << sz), 128);
  }
}

insn stur_q {
  encoding "00111100" "10" "0" imm9:9 "00" Rn:5 Rt:5
  asm "stur {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), vec[Rt]);
  }
}

insn ldur_q {
  encoding "00111100" "11" "0" imm9:9 "00" Rn:5 Rt:5
  asm "ldur {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    vec[Rt] = load(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), 128);
  }
}

insn str_fp_imm_post {
  encoding sz:2 "111100" "00" "0" imm9:9 "01" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}\], #{sextint(imm9, 9):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, trunc(vec[Rt], 8 << sz));
    write_gpr_sp(Rn, 1, base + imm(sextint(imm9, 9), 64));
  }
}

insn ldr_fp_imm_post {
  encoding sz:2 "111100" "01" "0" imm9:9 "01" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}\], #{sextint(imm9, 9):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = zext(load(base, 8 << sz), 128);
    write_gpr_sp(Rn, 1, base + imm(sextint(imm9, 9), 64));
  }
}

insn str_fp_imm_pre {
  encoding sz:2 "111100" "00" "0" imm9:9 "11" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]!"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64);
    store(base, trunc(vec[Rt], 8 << sz));
    write_gpr_sp(Rn, 1, base);
  }
}

insn ldr_fp_imm_pre {
  encoding sz:2 "111100" "01" "0" imm9:9 "11" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]!"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64);
    vec[Rt] = zext(load(base, 8 << sz), 128);
    write_gpr_sp(Rn, 1, base);
  }
}

insn str_q_imm_post {
  encoding "00111100" "10" "0" imm9:9 "01" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "str {Rt:vreg(128)}, \[{Rn:regsp(1)}\], #{sextint(imm9, 9):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, vec[Rt]);
    write_gpr_sp(Rn, 1, base + imm(sextint(imm9, 9), 64));
