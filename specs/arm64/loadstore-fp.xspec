// Loads and stores of SIMD and floating-point registers.
//
// Separate from the general-purpose forms because the register file differs, not
// because the addressing does; the modes and their scaling mirror the other file
// rule for rule. These are modelled while the vector arithmetic is not, since a
// spilled vector register is an ordinary memory access and the stack analysis
// has to see it.
// ---------------------------------------------------------------------------
// Loads and stores: SIMD and floating point registers
// ---------------------------------------------------------------------------
//
// The arithmetic on V registers is still an intrinsic, but the moves between
// them and memory are not, because they are ordinary memory accesses and the
// stack analysis has to see them. A prologue that spills q8..q15 and an epilogue
// that reloads them are, to anything reasoning about frames, eight stores and
// eight loads; leaving them opaque would make every such frame unreadable.
//
// One rule covers all four scalar widths. A load writes the whole 128-bit
// register zero-extended, which is what the architecture does and what removes
// the need to name a view: `ldr s0` is `v0 = zext(load(addr, 32), 128)`.

// Writing one lane of a vector means rebuilding the register around it. The
// two halves are handled separately because a mask is an ordinary 64-bit
// immediate, while a 128-bit one is not expressible here.
fn insert_bits64(h: bits(64), shift: int(0..63), mask: int, x: bits(64))
    -> bits(64) {
  let keep = imm(ones_int(64) ^ (mask << shift), 64);
  return (h & keep) | ((x & imm(mask, 64)) << imm(shift, 64));
}

// The caller passes the half and the offset within it rather than one lane
// offset, because in every encoding that reaches here the half is exactly the
// Q bit. Splitting it that way is what keeps both arguments provably in range:
// derived from Q and one other field, each is a small sum, whereas a single
// 0..127 offset would have to be narrowed back down by masking.
fn insert_lane(v: bits(128), half: int(0..1), shift: int(0..63), mask: int,
               x: bits(64)) -> bits(128) {
  if half == 1 {
    return concat(insert_bits64(extract(v, 64, 64), shift, mask, x),
                  extract(v, 0, 64));
  } else {
    return concat(extract(v, 64, 64),
                  insert_bits64(extract(v, 0, 64), shift, mask, x));
  }
}

fn replicate8(x: bits(8)) -> bits(64) {
  let pair = concat(x, x);
  let quad = concat(pair, pair);
  return concat(quad, quad);
}

fn replicate16(x: bits(16)) -> bits(64) {
  let pair = concat(x, x);
  return concat(pair, pair);
}

fn replicate32(x: bits(32)) -> bits(64) {
  return concat(x, x);
}

fn structure_even_bytes64(v: bits(64)) -> bits(32) {
  return concat(concat(extract(v, 48, 8), extract(v, 32, 8)),
                concat(extract(v, 16, 8), extract(v, 0, 8)));
}

fn structure_odd_bytes64(v: bits(64)) -> bits(32) {
  return concat(concat(extract(v, 56, 8), extract(v, 40, 8)),
                concat(extract(v, 24, 8), extract(v, 8, 8)));
}

fn structure_even_bytes128(v: bits(128)) -> bits(64) {
  return concat(structure_even_bytes64(extract(v, 64, 64)),
                structure_even_bytes64(extract(v, 0, 64)));
}

fn structure_odd_bytes128(v: bits(128)) -> bits(64) {
  return concat(structure_odd_bytes64(extract(v, 64, 64)),
                structure_odd_bytes64(extract(v, 0, 64)));
}

fn structure_bytes_mod4_0(v: bits(128)) -> bits(32) {
  return structure_even_bytes64(structure_even_bytes128(v));
}

fn structure_bytes_mod4_1(v: bits(128)) -> bits(32) {
  return structure_even_bytes64(structure_odd_bytes128(v));
}

fn structure_bytes_mod4_2(v: bits(128)) -> bits(32) {
  return structure_odd_bytes64(structure_even_bytes128(v));
}

fn structure_bytes_mod4_3(v: bits(128)) -> bits(32) {
  return structure_odd_bytes64(structure_odd_bytes128(v));
}

fn structure_halfwords_mod4_0(v: bits(128)) -> bits(32) {
  return concat(extract(v, 64, 16), extract(v, 0, 16));
}

fn structure_halfwords_mod4_1(v: bits(128)) -> bits(32) {
  return concat(extract(v, 80, 16), extract(v, 16, 16));
}

fn structure_halfwords_mod4_2(v: bits(128)) -> bits(32) {
  return concat(extract(v, 96, 16), extract(v, 32, 16));
}

fn structure_halfwords_mod4_3(v: bits(128)) -> bits(32) {
  return concat(extract(v, 112, 16), extract(v, 48, 16));
}

// Pack one 64-bit half from two or four structure registers in architectural
// lane order. These helpers are shared by every element arrangement.
fn interleave2_half(lane_bits: int, a: bits(64), b: bits(64)) -> bits(128) {
  if lane_bits == 8 {
    return concat(
        concat(concat(concat(extract(b, 56, 8), extract(a, 56, 8)),
                      concat(extract(b, 48, 8), extract(a, 48, 8))),
               concat(concat(extract(b, 40, 8), extract(a, 40, 8)),
                      concat(extract(b, 32, 8), extract(a, 32, 8)))),
        concat(concat(concat(extract(b, 24, 8), extract(a, 24, 8)),
                      concat(extract(b, 16, 8), extract(a, 16, 8))),
               concat(concat(extract(b, 8, 8), extract(a, 8, 8)),
                      concat(extract(b, 0, 8), extract(a, 0, 8)))));
  } else if lane_bits == 16 {
    return concat(
        concat(concat(extract(b, 48, 16), extract(a, 48, 16)),
               concat(extract(b, 32, 16), extract(a, 32, 16))),
        concat(concat(extract(b, 16, 16), extract(a, 16, 16)),
               concat(extract(b, 0, 16), extract(a, 0, 16))));
  } else if lane_bits == 32 {
    return concat(concat(extract(b, 32, 32), extract(a, 32, 32)),
                  concat(extract(b, 0, 32), extract(a, 0, 32)));
  } else {
    return concat(b, a);
  }
}

fn interleave4_first(lane_bits: int, a: bits(64), b: bits(64),
                     c: bits(64), d: bits(64)) -> bits(128) {
  if lane_bits == 8 {
    return concat(
        concat(concat(concat(extract(d, 24, 8), extract(c, 24, 8)),
                      concat(extract(b, 24, 8), extract(a, 24, 8))),
               concat(concat(extract(d, 16, 8), extract(c, 16, 8)),
                      concat(extract(b, 16, 8), extract(a, 16, 8)))),
        concat(concat(concat(extract(d, 8, 8), extract(c, 8, 8)),
                      concat(extract(b, 8, 8), extract(a, 8, 8))),
               concat(concat(extract(d, 0, 8), extract(c, 0, 8)),
                      concat(extract(b, 0, 8), extract(a, 0, 8)))));
  } else if lane_bits == 16 {
    return concat(
        concat(concat(extract(d, 16, 16), extract(c, 16, 16)),
               concat(extract(b, 16, 16), extract(a, 16, 16))),
        concat(concat(extract(d, 0, 16), extract(c, 0, 16)),
               concat(extract(b, 0, 16), extract(a, 0, 16))));
  } else if lane_bits == 32 {
    return concat(concat(extract(d, 0, 32), extract(c, 0, 32)),
                  concat(extract(b, 0, 32), extract(a, 0, 32)));
  } else {
    return concat(b, a);
  }
}

fn interleave4_second(lane_bits: int, a: bits(64), b: bits(64),
                      c: bits(64), d: bits(64)) -> bits(128) {
  if lane_bits == 8 {
    return concat(
        concat(concat(concat(extract(d, 56, 8), extract(c, 56, 8)),
                      concat(extract(b, 56, 8), extract(a, 56, 8))),
               concat(concat(extract(d, 48, 8), extract(c, 48, 8)),
                      concat(extract(b, 48, 8), extract(a, 48, 8)))),
        concat(concat(concat(extract(d, 40, 8), extract(c, 40, 8)),
                      concat(extract(b, 40, 8), extract(a, 40, 8))),
               concat(concat(extract(d, 32, 8), extract(c, 32, 8)),
                      concat(extract(b, 32, 8), extract(a, 32, 8)))));
  } else if lane_bits == 16 {
    return concat(
        concat(concat(extract(d, 48, 16), extract(c, 48, 16)),
               concat(extract(b, 48, 16), extract(a, 48, 16))),
        concat(concat(extract(d, 32, 16), extract(c, 32, 16)),
               concat(extract(b, 32, 16), extract(a, 32, 16))));
  } else if lane_bits == 32 {
    return concat(concat(extract(d, 32, 32), extract(c, 32, 32)),
                  concat(extract(b, 32, 32), extract(a, 32, 32)));
  } else {
    return concat(d, c);
  }
}

insn str_fp_imm_unsigned {
  encoding sz:2 "11110100" imm12:12 Rn:5 Rt:5
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{imm12 << sz:hex}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(imm12 << sz, 64), trunc(vec[Rt], 8 << sz));
  }
}

insn ldr_fp_imm_unsigned {
  encoding sz:2 "11110101" imm12:12 Rn:5 Rt:5
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{imm12 << sz:hex}\]"
  semantics {
    vec[Rt] = zext(load(read_gpr_sp(Rn, 1) + imm(imm12 << sz, 64), 8 << sz), 128);
  }
}

insn str_q_imm_unsigned {
  encoding "0011110110" imm12:12 Rn:5 Rt:5
  asm "str {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{imm12 << 4:hex}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(imm12 << 4, 64), vec[Rt]);
  }
}

insn ldr_q_imm_unsigned {
  encoding "0011110111" imm12:12 Rn:5 Rt:5
  asm "ldr {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{imm12 << 4:hex}\]"
  semantics {
    vec[Rt] = load(read_gpr_sp(Rn, 1) + imm(imm12 << 4, 64), 128);
  }
}

insn stur_fp {
  encoding sz:2 "111100" "00" "0" imm9:9 "00" Rn:5 Rt:5
  asm "stur {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), trunc(vec[Rt], 8 << sz));
  }
}

insn ldur_fp {
  encoding sz:2 "111100" "01" "0" imm9:9 "00" Rn:5 Rt:5
  asm "ldur {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    vec[Rt] = zext(load(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), 8 << sz), 128);
  }
}

insn stur_q {
  encoding "00111100" "10" "0" imm9:9 "00" Rn:5 Rt:5
  asm "stur {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    store(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), vec[Rt]);
  }
}

insn ldur_q {
  encoding "00111100" "11" "0" imm9:9 "00" Rn:5 Rt:5
  asm "ldur {Rt:vreg(128)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]"
  semantics {
    vec[Rt] = load(read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64), 128);
  }
}

insn str_fp_imm_post {
  encoding sz:2 "111100" "00" "0" imm9:9 "01" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}\], #{sextint(imm9, 9):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, trunc(vec[Rt], 8 << sz));
    write_gpr_sp(Rn, 1, base + imm(sextint(imm9, 9), 64));
  }
}

insn ldr_fp_imm_post {
  encoding sz:2 "111100" "01" "0" imm9:9 "01" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}\], #{sextint(imm9, 9):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = zext(load(base, 8 << sz), 128);
    write_gpr_sp(Rn, 1, base + imm(sextint(imm9, 9), 64));
  }
}

insn str_fp_imm_pre {
  encoding sz:2 "111100" "00" "0" imm9:9 "11" Rn:5 Rt:5
  require Rn == 31 || Rn != Rt;
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, #{sextint(imm9, 9):dec}\]!"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm9, 9), 64);
    store(base, trunc(vec[Rt], 8 << sz));
    write_gpr_sp(Rn, 1, base);
  }
}

