insn str_fp_reg_offset {
  encoding sz:2 "111100" "00" "1" Rm:5 option:3 S:1 "10" Rn:5 Rt:5
  require option == 2 || option == 3 || option == 6 || option == 7;
  asm "str {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, {Rm:reg(option & 1)}[, {option == 3 && S == 0 ? 0 : option + 1:extend}[ #{S == 1 ? sz : 0:dec}]]\]"
  semantics {
    let index = extend_reg(1, Rm, option, S == 1 ? sz : 0);
    store(read_gpr_sp(Rn, 1) + index, trunc(vec[Rt], 8 << sz));
  }
}

insn ldr_fp_reg_offset {
  encoding sz:2 "111100" "01" "1" Rm:5 option:3 S:1 "10" Rn:5 Rt:5
  require option == 2 || option == 3 || option == 6 || option == 7;
  asm "ldr {Rt:vreg(8 << sz)}, \[{Rn:regsp(1)}, {Rm:reg(option & 1)}[, {option == 3 && S == 0 ? 0 : option + 1:extend}[ #{S == 1 ? sz : 0:dec}]]\]"
  semantics {
    let index = extend_reg(1, Rm, option, S == 1 ? sz : 0);
    vec[Rt] = zext(load(read_gpr_sp(Rn, 1) + index, 8 << sz), 128);
  }
}

insn str_q_reg_offset {
  encoding "00111100" "10" "1" Rm:5 option:3 S:1 "10" Rn:5 Rt:5
  require option == 2 || option == 3 || option == 6 || option == 7;
  asm "str {Rt:vreg(128)}, \[{Rn:regsp(1)}, {Rm:reg(option & 1)}[, {option == 3 && S == 0 ? 0 : option + 1:extend}[ #{S == 1 ? 4 : 0:dec}]]\]"
  semantics {
    let index = extend_reg(1, Rm, option, S == 1 ? 4 : 0);
    store(read_gpr_sp(Rn, 1) + index, vec[Rt]);
  }
}

insn ldr_q_reg_offset {
  encoding "00111100" "11" "1" Rm:5 option:3 S:1 "10" Rn:5 Rt:5
  require option == 2 || option == 3 || option == 6 || option == 7;
  asm "ldr {Rt:vreg(128)}, \[{Rn:regsp(1)}, {Rm:reg(option & 1)}[, {option == 3 && S == 0 ? 0 : option + 1:extend}[ #{S == 1 ? 4 : 0:dec}]]\]"
  semantics {
    let index = extend_reg(1, Rm, option, S == 1 ? 4 : 0);
    vec[Rt] = load(read_gpr_sp(Rn, 1) + index, 128);
  }
}

// The pair forms are what a prologue actually uses. `opc` is the width here, not
// a size field: 00 is 32-bit, 01 is 64-bit, 10 is 128-bit, so the element is
// `32 << opc` bits and the second slot sits `4 << opc` bytes on.

insn stp_fp_offset {
  encoding opc:2 "101101" "0" "0" imm7:7 Rt2:5 Rn:5 Rt:5
  require opc != 3;
  asm "stp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    store(base, trunc(vec[Rt], 32 << opc));
    store(base + imm(4 << opc, 64), trunc(vec[Rt2], 32 << opc));
  }
}

insn ldp_fp_offset {
  encoding opc:2 "101101" "0" "1" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rt != Rt2;
  require opc != 3;
  asm "ldp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    vec[Rt] = zext(load(base, 32 << opc), 128);
    vec[Rt2] = zext(load(base + imm(4 << opc, 64), 32 << opc), 128);
  }
}

// The non-temporal pair forms differ from LDP/STP only in the index bits, and
// the hint they carry is about cache allocation. Nothing here models caches,
// so they behave exactly like the ordinary pair.
insn stnp_fp {
  encoding opc:2 "101100" "0" "0" imm7:7 Rt2:5 Rn:5 Rt:5
  require opc != 3;
  asm "stnp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    store(base, trunc(vec[Rt], 32 << opc));
    store(base + imm(4 << opc, 64), trunc(vec[Rt2], 32 << opc));
  }
}

insn ldnp_fp {
  encoding opc:2 "101100" "0" "1" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rt != Rt2;
  require opc != 3;
  asm "ldnp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    vec[Rt] = zext(load(base, 32 << opc), 128);
    vec[Rt2] = zext(load(base + imm(4 << opc, 64), 32 << opc), 128);
  }
}

insn stp_fp_pre {
  encoding opc:2 "101101" "1" "0" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rn == 31 || (Rn != Rt && Rn != Rt2);
  require opc != 3;
  asm "stp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]!"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    store(base, trunc(vec[Rt], 32 << opc));
    store(base + imm(4 << opc, 64), trunc(vec[Rt2], 32 << opc));
    write_gpr_sp(Rn, 1, base);
  }
}

insn ldp_fp_post {
  encoding opc:2 "101100" "1" "1" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rt != Rt2;
  require Rn == 31 || (Rn != Rt && Rn != Rt2);
  require opc != 3;
  asm "ldp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}\], #{sextint(imm7, 7) << (2 + opc):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = zext(load(base, 32 << opc), 128);
    vec[Rt2] = zext(load(base + imm(4 << opc, 64), 32 << opc), 128);
    write_gpr_sp(Rn, 1, base + imm(sextint(imm7, 7) << (2 + opc), 64));
  }
}

insn stp_fp_post {
  encoding opc:2 "101100" "1" "0" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rn == 31 || (Rn != Rt && Rn != Rt2);
  require opc != 3;
  asm "stp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}\], #{sextint(imm7, 7) << (2 + opc):dec}"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, trunc(vec[Rt], 32 << opc));
    store(base + imm(4 << opc, 64), trunc(vec[Rt2], 32 << opc));
    write_gpr_sp(Rn, 1, base + imm(sextint(imm7, 7) << (2 + opc), 64));
  }
}

insn ldp_fp_pre {
  encoding opc:2 "101101" "1" "1" imm7:7 Rt2:5 Rn:5 Rt:5
  require Rt != Rt2;
  require Rn == 31 || (Rn != Rt && Rn != Rt2);
  require opc != 3;
  asm "ldp {Rt:vreg(32 << opc)}, {Rt2:vreg(32 << opc)}, \[{Rn:regsp(1)}, #{sextint(imm7, 7) << (2 + opc):dec}\]!"
  semantics {
    let base = read_gpr_sp(Rn, 1) + imm(sextint(imm7, 7) << (2 + opc), 64);
    vec[Rt] = zext(load(base, 32 << opc), 128);
    vec[Rt2] = zext(load(base + imm(4 << opc, 64), 32 << opc), 128);
    write_gpr_sp(Rn, 1, base);
  }
}

insn ldr_fp_literal {
  encoding opc:2 "011100" imm19:19 Rt:5
  require opc != 3;
  asm "ldr {Rt:vreg(32 << opc)}, #{insn_pc + (sextint(imm19, 19) << 2):hex}"
  semantics {
    vec[Rt] = zext(load(imm(insn_pc + (sextint(imm19, 19) << 2), 64), 32 << opc), 128);
  }
}

// ---------------------------------------------------------------------------
// Advanced SIMD load/store single structure
// ---------------------------------------------------------------------------
//
// One lane moves between memory and a vector register. These are ordinary
// memory accesses with an awkward operand, not vector arithmetic, so they are
// modelled for the same reason the whole-register forms are.
//
// Each rule covers all three addressing modes the family has, because they
// differ only in two fields: bit 23 selects post-indexing, and within that an
// Rm of 31 selects an immediate step equal to the transfer size instead of a
// register step. Splitting them into separate rules would triple the count
// without separating anything that behaves differently.
//
// `require post == 1 || Rm == 0` keeps the non-indexed form from claiming
// encodings the architecture leaves unallocated: with bit 23 clear, Rm is a
// field that must read as zero rather than a register number.
//
// The lane index is assembled from Q, S and size, which is how the
// architecture spends three scattered bits to name up to sixteen lanes. Q is
// always its top bit, so Q alone says which half of the register is touched
// and the remaining bits say where within that half.
//
// The 16-bit forms split the size field into its two bits rather than
// matching it whole, because only the upper one carries lane information and
// the lower one is required to be zero. Writing that into the encoding is
// what lets the lane arrive already provably in range.

insn ld1_single_8 {
  encoding "0" Q:1 "001101" post:1 "1" "0" Rm:5 "000" S:1 size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld1 \{{Rt:vreg(128)}.b\}[{Q * 8 + S * 4 + size:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, (S * 4 + size) * 8, 0xff,
                          zext(load(base, 8), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(1, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st1_single_8 {
  encoding "0" Q:1 "001101" post:1 "0" "0" Rm:5 "000" S:1 size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st1 \{{Rt:vreg(128)}.b\}[{Q * 8 + S * 4 + size:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, extract(vec[Rt], (Q * 8 + S * 4 + size) * 8, 8));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(1, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld1_single_16 {
  encoding "0" Q:1 "001101" post:1 "1" "0" Rm:5 "010" S:1 sizehi:1 "0" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld1 \{{Rt:vreg(128)}.h\}[{Q * 4 + S * 2 + sizehi:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, (S * 2 + sizehi) * 16, 0xffff,
                          zext(load(base, 16), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(2, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st1_single_16 {
  encoding "0" Q:1 "001101" post:1 "0" "0" Rm:5 "010" S:1 sizehi:1 "0" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st1 \{{Rt:vreg(128)}.h\}[{Q * 4 + S * 2 + sizehi:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, extract(vec[Rt], (Q * 4 + S * 2 + sizehi) * 16, 16));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(2, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld1_single_32 {
  encoding "0" Q:1 "001101" post:1 "1" "0" Rm:5 "100" S:1 "00" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld1 \{{Rt:vreg(128)}.s\}[{Q * 2 + S:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, S * 32, 0xffffffff,
                          zext(load(base, 32), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(4, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st1_single_32 {
  encoding "0" Q:1 "001101" post:1 "0" "0" Rm:5 "100" S:1 "00" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st1 \{{Rt:vreg(128)}.s\}[{Q * 2 + S:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, extract(vec[Rt], (Q * 2 + S) * 32, 32));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(4, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld1_single_64 {
  encoding "0" Q:1 "001101" post:1 "1" "0" Rm:5 "100" "0" "01" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld1 \{{Rt:vreg(128)}.d\}[{Q:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, 0, ones_int(64), load(base, 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(8, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st1_single_64 {
  encoding "0" Q:1 "001101" post:1 "0" "0" Rm:5 "100" "0" "01" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st1 \{{Rt:vreg(128)}.d\}[{Q:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, extract(vec[Rt], Q * 64, 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(8, 64) : read_gpr(Rm, 1)));
    }
  }
}

// Single-structure stores write the selected lane from consecutive registers.
// The register list wraps modulo 32 and post-index accepts either the encoded
// structure size or a general-purpose register.
insn st2_single_8 {
  encoding "0" Q:1 "001101" post:1 "0" "1" Rm:5 "000" S:1 size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st2 \{{Rt:vreg(128)}.b, ...\}[{Q * 8 + S * 4 + size:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    let lane = (Q * 8 + S * 4 + size) * 8;
    store(base, extract(vec[Rt], lane, 8));
    store(base + imm(1, 64), extract(vec[(Rt + 1) & 31], lane, 8));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(2, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st4_single_8 {
  encoding "0" Q:1 "001101" post:1 "0" "1" Rm:5 "001" S:1 size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st4 \{{Rt:vreg(128)}.b, ...\}[{Q * 8 + S * 4 + size:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    let lane = (Q * 8 + S * 4 + size) * 8;
    store(base, extract(vec[Rt], lane, 8));
    store(base + imm(1, 64), extract(vec[(Rt + 1) & 31], lane, 8));
    store(base + imm(2, 64), extract(vec[(Rt + 2) & 31], lane, 8));
    store(base + imm(3, 64), extract(vec[(Rt + 3) & 31], lane, 8));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(4, 64) : read_gpr(Rm, 1)));
    }
  }
}

// LD4 single-structure forms load one lane in each of four consecutive vector
// registers. The memory elements are contiguous and the register list wraps.
insn ld4_single_8 {
  encoding "0" Q:1 "001101" post:1 "1" "1" Rm:5 "001" S:1 size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.b, ...\}[{Q * 8 + S * 4 + size:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, (S * 4 + size) * 8, 0xff,
                          zext(load(base, 8), 64));
    vec[(Rt + 1) & 31] = insert_lane(vec[(Rt + 1) & 31], Q,
        (S * 4 + size) * 8, 0xff, zext(load(base + imm(1, 64), 8), 64));
    vec[(Rt + 2) & 31] = insert_lane(vec[(Rt + 2) & 31], Q,
        (S * 4 + size) * 8, 0xff, zext(load(base + imm(2, 64), 8), 64));
    vec[(Rt + 3) & 31] = insert_lane(vec[(Rt + 3) & 31], Q,
        (S * 4 + size) * 8, 0xff, zext(load(base + imm(3, 64), 8), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(4, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld4_single_16 {
  encoding "0" Q:1 "001101" post:1 "1" "1" Rm:5 "011" S:1 sizehi:1 "0" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.h, ...\}[{Q * 4 + S * 2 + sizehi:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, (S * 2 + sizehi) * 16, 0xffff,
                          zext(load(base, 16), 64));
    vec[(Rt + 1) & 31] = insert_lane(vec[(Rt + 1) & 31], Q,
        (S * 2 + sizehi) * 16, 0xffff, zext(load(base + imm(2, 64), 16), 64));
    vec[(Rt + 2) & 31] = insert_lane(vec[(Rt + 2) & 31], Q,
        (S * 2 + sizehi) * 16, 0xffff, zext(load(base + imm(4, 64), 16), 64));
    vec[(Rt + 3) & 31] = insert_lane(vec[(Rt + 3) & 31], Q,
        (S * 2 + sizehi) * 16, 0xffff, zext(load(base + imm(6, 64), 16), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(8, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld4_single_32 {
  encoding "0" Q:1 "001101" post:1 "1" "1" Rm:5 "101" S:1 "00" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.s, ...\}[{Q * 2 + S:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, S * 32, 0xffffffff,
                          zext(load(base, 32), 64));
    vec[(Rt + 1) & 31] = insert_lane(vec[(Rt + 1) & 31], Q, S * 32,
        0xffffffff, zext(load(base + imm(4, 64), 32), 64));
    vec[(Rt + 2) & 31] = insert_lane(vec[(Rt + 2) & 31], Q, S * 32,
        0xffffffff, zext(load(base + imm(8, 64), 32), 64));
    vec[(Rt + 3) & 31] = insert_lane(vec[(Rt + 3) & 31], Q, S * 32,
        0xffffffff, zext(load(base + imm(12, 64), 32), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(16, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld4_single_64 {
  encoding "0" Q:1 "001101" post:1 "1" "1" Rm:5 "101" "0" "01" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.d, ...\}[{Q:dec}], \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    vec[Rt] = insert_lane(vec[Rt], Q, 0, ones_int(64), load(base, 64));
    vec[(Rt + 1) & 31] = insert_lane(vec[(Rt + 1) & 31], Q, 0,
        ones_int(64), load(base + imm(8, 64), 64));
    vec[(Rt + 2) & 31] = insert_lane(vec[(Rt + 2) & 31], Q, 0,
        ones_int(64), load(base + imm(16, 64), 64));
    vec[(Rt + 3) & 31] = insert_lane(vec[(Rt + 3) & 31], Q, 0,
        ones_int(64), load(base + imm(24, 64), 64));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(32, 64) : read_gpr(Rm, 1)));
    }
  }
}

// LD1R loads one element and fills every lane with it. Q selects whether the
// upper half is written too; the architecture zeroes it when Q is clear,
// which is what makes a load of the 64-bit form observable as a full write.
insn ld1r {
  encoding "0" Q:1 "001101" post:1 "1" "0" Rm:5 "110" "0" size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld1r \{{Rt:vreg(128)}\}, \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    if size == 0 {
      let filled = replicate8(load(base, 8));
      vec[Rt] = Q == 1 ? concat(filled, filled) : zext(filled, 128);
    } else {
      if size == 1 {
        let filled = replicate16(load(base, 16));
        vec[Rt] = Q == 1 ? concat(filled, filled) : zext(filled, 128);
      } else {
        if size == 2 {
          let filled = replicate32(load(base, 32));
          vec[Rt] = Q == 1 ? concat(filled, filled) : zext(filled, 128);
        } else {
          let filled = load(base, 64);
          vec[Rt] = Q == 1 ? concat(filled, filled) : zext(filled, 128);
        }
      }
    }
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   base + (Rm == 31 ? imm(1 << size, 64) : read_gpr(Rm, 1)));
    }
  }
}

// LD2 {Vt.16B, Vt2.16B}: de-interleave 32 consecutive bytes.
insn ld2_16b {
  encoding "0100110001000000100000" Rn:5 "00000"
  asm "ld2 v0.16b, v1.16b, \[{Rn:regsp(1)}\]"
  semantics {
    let address = read_gpr_sp(Rn, 1);
    let low = load(address, 128);
    let high = load(address + imm(16, 64), 128);
    vec[0] = concat(structure_even_bytes128(high),
                    structure_even_bytes128(low));
    vec[1] = concat(structure_odd_bytes128(high),
                    structure_odd_bytes128(low));
  }
}

// Multiple-structure stores interleave equal-width lanes from consecutive
// vector registers. Q selects a 64- or 128-bit source from each register.
insn st2_multiple {
  encoding "0" Q:1 "001100" post:1 "0" "0" Rm:5 "1000" size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st2 \{{Rt:vreg(64 << Q)}, ...\}, \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, interleave2_half(8 << size, vec[Rt].d,
                                 vec[(Rt + 1) & 31].d));
    if Q == 1 {
      store(base + imm(16, 64),
            interleave2_half(8 << size, extract(vec[Rt], 64, 64),
                extract(vec[(Rt + 1) & 31], 64, 64)));
    }
    if post == 1 {
      write_gpr_sp(Rn, 1, base + (Rm == 31
          ? imm(16 << Q, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn st4_multiple {
  encoding "0" Q:1 "001100" post:1 "0" "0" Rm:5 "0000" size:2 Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "st4 \{{Rt:vreg(64 << Q)}, ...\}, \[{Rn:regsp(1)}\]"
  semantics {
    let base = read_gpr_sp(Rn, 1);
    store(base, interleave4_first(8 << size, vec[Rt].d,
        vec[(Rt + 1) & 31].d, vec[(Rt + 2) & 31].d,
        vec[(Rt + 3) & 31].d));
    store(base + imm(16, 64), interleave4_second(8 << size, vec[Rt].d,
        vec[(Rt + 1) & 31].d, vec[(Rt + 2) & 31].d,
        vec[(Rt + 3) & 31].d));
    if Q == 1 {
      store(base + imm(32, 64), interleave4_first(8 << size,
          extract(vec[Rt], 64, 64),
          extract(vec[(Rt + 1) & 31], 64, 64),
          extract(vec[(Rt + 2) & 31], 64, 64),
          extract(vec[(Rt + 3) & 31], 64, 64)));
      store(base + imm(48, 64), interleave4_second(8 << size,
          extract(vec[Rt], 64, 64),
          extract(vec[(Rt + 1) & 31], 64, 64),
          extract(vec[(Rt + 2) & 31], 64, 64),
          extract(vec[(Rt + 3) & 31], 64, 64)));
    }
    if post == 1 {
      write_gpr_sp(Rn, 1, base + (Rm == 31
          ? imm(32 << Q, 64) : read_gpr(Rm, 1)));
    }
  }
}

// LD4 {Vt.16B-Vt4.16B}: de-interleave 64 consecutive bytes across four
// vector registers. Consecutive register lists wrap modulo 32.
insn ld4_16b {
  encoding "01001100" post:1 "1" "0" Rm:5 "0000" "00" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.16b, ...\}, \[{Rn:regsp(1)}\]"
  semantics {
    let address = read_gpr_sp(Rn, 1);
    let block0 = load(address, 128);
    let block1 = load(address + imm(16, 64), 128);
    let block2 = load(address + imm(32, 64), 128);
    let block3 = load(address + imm(48, 64), 128);
    vec[Rt] = concat(
        concat(structure_bytes_mod4_0(block3),
               structure_bytes_mod4_0(block2)),
        concat(structure_bytes_mod4_0(block1),
               structure_bytes_mod4_0(block0)));
    vec[(Rt + 1) & 31] = concat(
        concat(structure_bytes_mod4_1(block3),
               structure_bytes_mod4_1(block2)),
        concat(structure_bytes_mod4_1(block1),
               structure_bytes_mod4_1(block0)));
    vec[(Rt + 2) & 31] = concat(
        concat(structure_bytes_mod4_2(block3),
               structure_bytes_mod4_2(block2)),
        concat(structure_bytes_mod4_2(block1),
               structure_bytes_mod4_2(block0)));
    vec[(Rt + 3) & 31] = concat(
        concat(structure_bytes_mod4_3(block3),
               structure_bytes_mod4_3(block2)),
        concat(structure_bytes_mod4_3(block1),
               structure_bytes_mod4_3(block0)));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   address + (Rm == 31 ? imm(64, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld4_8h {
  encoding "01001100" post:1 "1" "0" Rm:5 "0000" "01" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.8h, ...\}, \[{Rn:regsp(1)}\]"
  semantics {
    let address = read_gpr_sp(Rn, 1);
    let block0 = load(address, 128);
    let block1 = load(address + imm(16, 64), 128);
    let block2 = load(address + imm(32, 64), 128);
    let block3 = load(address + imm(48, 64), 128);
    vec[Rt] = concat(
        concat(structure_halfwords_mod4_0(block3),
               structure_halfwords_mod4_0(block2)),
        concat(structure_halfwords_mod4_0(block1),
               structure_halfwords_mod4_0(block0)));
    vec[(Rt + 1) & 31] = concat(
        concat(structure_halfwords_mod4_1(block3),
               structure_halfwords_mod4_1(block2)),
        concat(structure_halfwords_mod4_1(block1),
               structure_halfwords_mod4_1(block0)));
    vec[(Rt + 2) & 31] = concat(
        concat(structure_halfwords_mod4_2(block3),
               structure_halfwords_mod4_2(block2)),
        concat(structure_halfwords_mod4_2(block1),
               structure_halfwords_mod4_2(block0)));
    vec[(Rt + 3) & 31] = concat(
        concat(structure_halfwords_mod4_3(block3),
               structure_halfwords_mod4_3(block2)),
        concat(structure_halfwords_mod4_3(block1),
               structure_halfwords_mod4_3(block0)));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   address + (Rm == 31 ? imm(64, 64) : read_gpr(Rm, 1)));
    }
  }
}

insn ld4_4s {
  encoding "01001100" post:1 "1" "0" Rm:5 "0000" "10" Rn:5 Rt:5
  require post == 1 || Rm == 0;
  asm "ld4 \{{Rt:vreg(128)}.4s, ...\}, \[{Rn:regsp(1)}\]"
  semantics {
    let address = read_gpr_sp(Rn, 1);
    let block0 = load(address, 128);
    let block1 = load(address + imm(16, 64), 128);
    let block2 = load(address + imm(32, 64), 128);
    let block3 = load(address + imm(48, 64), 128);
    vec[Rt] = concat(
        concat(extract(block3, 0, 32), extract(block2, 0, 32)),
        concat(extract(block1, 0, 32), extract(block0, 0, 32)));
    vec[(Rt + 1) & 31] = concat(
        concat(extract(block3, 32, 32), extract(block2, 32, 32)),
        concat(extract(block1, 32, 32), extract(block0, 32, 32)));
    vec[(Rt + 2) & 31] = concat(
        concat(extract(block3, 64, 32), extract(block2, 64, 32)),
        concat(extract(block1, 64, 32), extract(block0, 64, 32)));
    vec[(Rt + 3) & 31] = concat(
        concat(extract(block3, 96, 32), extract(block2, 96, 32)),
        concat(extract(block1, 96, 32), extract(block0, 96, 32)));
    if post == 1 {
      write_gpr_sp(Rn, 1,
                   address + (Rm == 31 ? imm(64, 64) : read_gpr(Rm, 1)));
    }
  }
}
