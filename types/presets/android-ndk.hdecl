// Android NDK preset: the declarations a native library actually touches.
//
// This is not a copy of the NDK sysroot. It is the set of types and prototypes
// that show up when reading decompiled JNI code — the JNI handles, the libc
// calls a .so makes through the PLT, and the structs those calls fill in.
// Importing it turns `uint64_t sub_841ac(uint64_t a0, uint64_t a1)` into
// `jint JNI_OnLoad(JavaVM *vm, void *reserved)`.
//
// Import with `--types android-ndk`. Stack a project header on top of it with
// a second `--types`; later files win on conflicts only when they agree, and
// a real conflict is reported rather than silently resolved.
//
// The fixed-width integer names (uint8_t … uintptr_t, size_t, ssize_t) are
// built into the type database and are not repeated here.

// ---------------------------------------------------------------------------
// JNI
// ---------------------------------------------------------------------------

typedef uint8_t jboolean;
typedef int8_t jbyte;
typedef uint16_t jchar;
typedef int16_t jshort;
typedef int32_t jint;
typedef int64_t jlong;
typedef float jfloat;
typedef double jdouble;
typedef int32_t jsize;

// JNI reference types are opaque pointers in C. Keeping them distinct from
// `void*` is the whole point: a decompiled call taking a `jobject` reads very
// differently from one taking an arbitrary pointer.
typedef struct _jobject *jobject;
typedef jobject jclass;
typedef jobject jstring;
typedef jobject jarray;
typedef jobject jthrowable;
typedef jobject jweak;
typedef jarray jobjectArray;
typedef jarray jbooleanArray;
typedef jarray jbyteArray;
typedef jarray jcharArray;
typedef jarray jshortArray;
typedef jarray jintArray;
typedef jarray jlongArray;
typedef jarray jfloatArray;
typedef jarray jdoubleArray;

typedef struct _jfieldID *jfieldID;
typedef struct _jmethodID *jmethodID;

// The function tables. Their contents are indirect-call targets, so the
// members are what let a `[x0 + 0x2b8]` call print as `GetMethodID`. Only the
// shape matters here; the emitter reads offsets, not names it invents.
struct JNINativeInterface;
struct JNIInvokeInterface;

typedef const struct JNINativeInterface *JNIEnv;
typedef const struct JNIInvokeInterface *JavaVM;

typedef struct {
  const char *name;
  const char *signature;
  void *fnPtr;
} JNINativeMethod;

// The eight JNIEnv entry points source_jni.c exercises. Function-pointer
// typedefs rather than inline members because the struct below needs the
// same signature in one place, not repeated per pad run.
typedef jclass (*JNI_FindClassFn)(JNIEnv *env, const char *name);
typedef jclass (*JNI_GetObjectClassFn)(JNIEnv *env, jobject obj);
typedef jmethodID (*JNI_GetMethodIDFn)(JNIEnv *env, jclass clazz,
                                       const char *name, const char *sig);
typedef jobject (*JNI_CallObjectMethodFn)(JNIEnv *env, jobject obj,
                                           jmethodID methodID, ...);
typedef jint (*JNI_CallIntMethodFn)(JNIEnv *env, jobject obj,
                                     jmethodID methodID, ...);
typedef jstring (*JNI_NewStringUTFFn)(JNIEnv *env, const char *bytes);
typedef jint (*JNI_RegisterNativesFn)(JNIEnv *env, jclass clazz,
                                      const JNINativeMethod *methods,
                                      jint nMethods);
typedef jboolean (*JNI_ExceptionCheckFn)(JNIEnv *env);

// The real jni.h table, in its real order: the JNI ABI has been frozen at
// this layout since 1.2, so every native library's vtable matches it
// exactly. Only the eight members above are named; everything else is
// pointer-sized padding so the named ones land at their real offsets --
// `void*` and a function pointer are both one word wide, so a run of them
// costs nothing but the count.
struct JNINativeInterface {
  void *pad0[6];                        // reserved0..3, GetVersion, DefineClass
  JNI_FindClassFn FindClass;             // 6, +0x30
  void *pad1[24];                        // FromReflectedMethod .. NewObjectA
  JNI_GetObjectClassFn GetObjectClass;   // 31, +0xf8
  void *pad2[1];                         // IsInstanceOf
  JNI_GetMethodIDFn GetMethodID;         // 33, +0x108
  JNI_CallObjectMethodFn CallObjectMethod; // 34, +0x110
  void *pad3[14];                        // CallObjectMethodV .. CallShortMethodA
  JNI_CallIntMethodFn CallIntMethod;     // 49, +0x188
  void *pad4[117];                       // CallIntMethodV .. ReleaseStringChars
  JNI_NewStringUTFFn NewStringUTF;       // 167, +0x538
  void *pad5[47];                        // GetStringUTFLength .. SetDoubleArrayRegion
  JNI_RegisterNativesFn RegisterNatives; // 215, +0x6b8
  void *pad6[12];                        // UnregisterNatives .. DeleteWeakGlobalRef
  JNI_ExceptionCheckFn ExceptionCheck;   // 228, +0x720
  void *pad7[4];                         // NewDirectByteBuffer .. GetObjectRefType
};

// ---------------------------------------------------------------------------
// libc: the calls a native library reaches for through the PLT
// ---------------------------------------------------------------------------

void *malloc(size_t size);
void *calloc(size_t count, size_t size);
void *realloc(void *ptr, size_t size);
void free(void *ptr);

void *memcpy(void *dst, const void *src, size_t n);
void *memmove(void *dst, const void *src, size_t n);
void *memset(void *dst, int value, size_t n);
int memcmp(const void *lhs, const void *rhs, size_t n);
void *memchr(const void *buf, int value, size_t n);

size_t strlen(const char *s);
char *strcpy(char *dst, const char *src);
char *strncpy(char *dst, const char *src, size_t n);
char *strcat(char *dst, const char *src);
int strcmp(const char *lhs, const char *rhs);
int strncmp(const char *lhs, const char *rhs, size_t n);
char *strstr(const char *haystack, const char *needle);
char *strchr(const char *s, int c);
char *strrchr(const char *s, int c);
char *strdup(const char *s);

int snprintf(char *buf, size_t size, const char *format, ...);
int sprintf(char *buf, const char *format, ...);
int printf(const char *format, ...);
int puts(const char *s);

void *dlopen(const char *filename, int flags);
void *dlsym(void *handle, const char *symbol);
int dlclose(void *handle);
char *dlerror(void);

void abort(void);
void exit(int status);
void __stack_chk_fail(void);
int atoi(const char *s);
long strtol(const char *s, char **end, int base);

int open(const char *path, int flags, ...);
ssize_t read(int fd, void *buf, size_t count);
ssize_t write(int fd, const void *buf, size_t count);
int close(int fd);
off_t lseek(int fd, off_t offset, int whence);

int access(const char *path, int mode);
ssize_t readlink(const char *path, char *buf, size_t bufsiz);
pid_t getpid(void);
pid_t gettid(void);
uid_t getuid(void);
int prctl(int option, unsigned long a2, unsigned long a3, unsigned long a4,
          unsigned long a5);

// Opaque: every call here only passes a buffer's address or tests the return
// value, never a field, so a forward declaration is all a call site needs
// (see struct JNINativeInterface above for the same pattern).
struct stat;
int stat(const char *path, struct stat *buf);

struct FILE;
typedef struct FILE FILE;
FILE *fopen(const char *path, const char *mode);
size_t fread(void *ptr, size_t size, size_t n, FILE *stream);
int fclose(FILE *stream);

char *getenv(const char *name);

// System properties: Android's device-fingerprint store (ro.product.*,
// ro.build.version.sdk, ...), reached by every native library that checks
// what it is running on.
struct prop_info;
int __system_property_get(const char *name, char *value);
const struct prop_info *__system_property_find(const char *name);

// The per-thread error slot: `errno` is this call's result dereferenced, not
// a symbol of its own, so a write through it is what the code actually does
// (see sub_199214-shaped syscall wrappers, which store -errno here).
int *__errno_location(void);

void *mmap(void *addr, size_t length, int prot, int flags, int fd, off_t offset);
int munmap(void *addr, size_t length);
int mprotect(void *addr, size_t length, int prot);

// A raw syscall escape hatch, and the anti-debug check built on it -- both
// common in a native library that hand-rolls what libc would otherwise wrap.
long syscall(long number, ...);
long ptrace(int request, pid_t pid, void *addr, void *data);

int kill(pid_t pid, int sig);
unsigned int sleep(unsigned int seconds);
int usleep(unsigned int usec);

// ---------------------------------------------------------------------------
// Time and the structs syscalls fill in
// ---------------------------------------------------------------------------

struct timeval {
  time_t tv_sec;
  suseconds_t tv_usec;
};

struct timespec {
  time_t tv_sec;
  long tv_nsec;
};

struct timezone {
  int tz_minuteswest;
  int tz_dsttime;
};

int gettimeofday(struct timeval *tv, struct timezone *tz);
int clock_gettime(int clock_id, struct timespec *ts);
time_t time(time_t *out);
int nanosleep(const struct timespec *request, struct timespec *remain);

// ---------------------------------------------------------------------------
// pthreads
// ---------------------------------------------------------------------------

typedef long pthread_t;
typedef struct { int64_t opaque[4]; } pthread_mutex_t;
typedef struct { int64_t opaque[6]; } pthread_cond_t;
typedef struct { int32_t opaque[1]; } pthread_once_t;
typedef int32_t pthread_key_t;

int pthread_mutex_lock(pthread_mutex_t *mutex);
int pthread_mutex_unlock(pthread_mutex_t *mutex);
int pthread_once(pthread_once_t *control, void (*init)(void));
int pthread_key_create(pthread_key_t *key, void (*destructor)(void *));
void *pthread_getspecific(pthread_key_t key);
int pthread_setspecific(pthread_key_t key, const void *value);
pthread_t pthread_self(void);

// ---------------------------------------------------------------------------
// Android logging
// ---------------------------------------------------------------------------

int __android_log_print(int priority, const char *tag, const char *format, ...);
int __android_log_write(int priority, const char *tag, const char *text);
